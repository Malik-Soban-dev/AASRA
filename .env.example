# Copy to a local .dev.vars file when testing Worker Functions locally.
# Do not put live credentials in source control. Payments remain disabled unless
# every secret and the verified Safepay contract is configured.
PUBLIC_BASE_URL=https://aasra.shop
ALLOWED_ORIGIN=https://aasra.shop,https://www.aasra.shop
DEFAULT_DEPOSIT_PERCENT=30
BALANCE_REMINDER_DAYS=3,1
BALANCE_CANCEL_AFTER_DAYS=7

# D1: add a real database binding in wrangler.toml after creating AASRA_DB.
# Turnstile: configure a real site key in the checkout UI and secret here.
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# Safepay: acquire merchant credentials and verify checkout/webhook contract first.
# SAFEPAY_ENABLED=false
# SAFEPAY_PROTOCOL_VERIFIED=false
# SAFEPAY_CHECKOUT_ENDPOINT=
# SAFEPAY_SECRET_KEY=
# SAFEPAY_WEBHOOK_SECRET=

# Email: configure only after a provider adapter and credentials are in place.
# EMAIL_PROVIDER=
# EMAIL_PROVIDER_API_KEY=
# EMAIL_FROM=
# EMAIL_FROM_NAME=AASRA
