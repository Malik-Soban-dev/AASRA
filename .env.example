# Copy to .env (dev only) — NEVER commit real values.
# For Cloudflare Pages, set these via `wrangler pages secret put` / `wrangler pages variable put`.

# --- Non-secret variables (wrangler pages variable put) ---
PUBLIC_BASE_URL=https://aasra.shop
DEFAULT_DEPOSIT_PERCENT=30
BALANCE_REMINDER_DAYS=3,1
BALANCE_CANCEL_AFTER_DAYS=7

# --- Secrets (wrangler pages secret put) ---
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000000000000
SAFEPAY_SECRET_KEY=sk_live_...
SAFEPAY_WEBHOOK_SECRET=whsec_...
EMAIL_PROVIDER_API_KEY=...
EMAIL_PROVIDER=resend
EMAIL_FROM=orders@aasra.shop
EMAIL_FROM_NAME=AASRA
ALLOWED_ORIGIN=https://aasra.shop

# --- Turnstile sitekey (frontend, not a secret) ---
# Set in src/pages/checkout.astro and src/pages/contact.astro
# TURNSTILE_SITEKEY=1x0000000000000000000000000000000000000000
