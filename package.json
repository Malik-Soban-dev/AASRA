{
  "name": "aasra-store",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "description": "Headless e-commerce store for Pakistan on Cloudflare (Astro + Workers static assets + D1)",
  "scripts": {
    "dev": "npm run build && wrangler dev",
    "build": "astro build && wrangler pages functions build --outdir dist-worker --compatibility-date 2026-01-01 --compatibility-flags nodejs_compat",
    "preview": "npm run build && wrangler dev",
    "deploy": "wrangler deploy",
    "d1:create": "wrangler d1 create AASRA_DB",
    "d1:execute": "wrangler d1 execute AASRA_DB --file=migrations/0001_initial.sql --remote",
    "d1:execute:0002": "wrangler d1 execute AASRA_DB --file=migrations/0002_balance_token.sql --remote",
"d1:migrate": "wrangler d1 migrations apply AASRA_DB --remote",
    "d1:seed": "node scripts/seed-d1.js",
    "test": "node tests/run.js",
    "smoke": "node scripts/smoke-worker.mjs",
    "typecheck": "astro check"
  },
  "dependencies": {
    "@fontsource/cormorant-garamond": "^5.3.0",
    "astro": "^7.4.12"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "typescript": "^5.6.0",
    "wrangler": "^4.163.0"
  },
  "engines": {
    "node": ">=22.23.4"
  }
}
