---
import { formatPKR } from '../lib/products.js';

interface Props {
  product: any;
  variant?: any;
}

const { product, variant } = Astro.props;

const firstVariant = variant || product.variants[0];
const image = product.images[0] || '/images/placeholder.svg';
---

<article class="product-card">
  <a href={`/product/${product.slug}`}>
    <div class="product-image" style="padding-top: ${product.aspectRatio || 100}%;">
      <img
        src={image}
        alt={product.name}
        loading="lazy"
        width="400"
        height="400"
      />
    </div>
    <div class="product-info">
      <h3 class="product-name">{product.name}</h3>
      <div class="product-color">{firstVariant?.size || ''}</div>
      <div class="product-price">{formatPKR(product.price_pkr)}</div>
      <div class="product-colors">{product.variants.length} variants</div>
    </div>
  </a>
</article>

<style>
  .product-card {
    background: var(--surface);
    border: 1px solid var(--border);
    display: contents;
  }
  .product-card a { display: contents; text-decoration: none; color: inherit; }
  .product-image {
    width: 100%;
    position: relative;
    overflow: hidden;
    background: #fafafa;
  }
  .product-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .product-info { padding: 1rem; }
  .product-name { font-size: 0.95rem; margin-bottom: 0.25rem; font-weight: 400; }
  .product-color { font-size: 0.75rem; color: var(--muted); text-transform: uppercase; letter-spacing: 0.1em; margin-bottom: 0.5rem; }
  .product-price { font-size: 1rem; font-weight: 500; }
  .product-colors { font-size: 0.7rem; color: var(--muted); margin-top: 0.25rem; }
</style>
