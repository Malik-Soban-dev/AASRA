---
/**
 * Layout — compatibility shell. Every page now renders inside the store shell
 * (header, footer, design tokens, cart and CSRF contracts) via StoreLayout.
 * Legacy page content keeps its own stylesheets so pages are not restyled blindly;
 * new pages should use StoreLayout directly.
 */
import '@fontsource/cormorant-garamond/500.css';
import '@fontsource/cormorant-garamond/600.css';
import '../styles/global.css';
import '../styles/luxury-refinements.css';
import '../styles/aasra-storefront.css';
import StoreLayout from './layout/StoreLayout.astro';

export interface Props {
  title?: string;
  description?: string;
}

const { title = 'AASRA', description = 'AASRA — considered essentials for the home' } = Astro.props;
---

<StoreLayout title={title} description={description}>
  <slot />
</StoreLayout>
