---
/**
 * StoreLayout — storefront layout (design system + tokens + cart shim).
 * Fonts: Google Fonts CDN with system fallbacks (CDN policy, ARCHITECTURE.md).
 */
import SiteHeader from '../store/SiteHeader.astro';
import SiteFooter from '../store/SiteFooter.astro';
import '../../styles/tokens.css';
import '../../styles/store.css';

const {
  title = 'AASRA — Slow made, in Pakistan',
  description = 'Handloom clothing for women and men, made slowly in Pakistan.',
  snap = false,
} = Astro.props;
---

<!doctype html>
<html lang="en" class:list={{ 'as-snap': snap }}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter+Tight:wght@400;500;600&family=Inter:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <div class="as-progress" id="as-progress" aria-hidden="true"></div>
    <SiteHeader />
    <main id="main">
      <slot />
    </main>
    <SiteFooter />

    <!-- Added-to-bag confirmation: slides in after an add, like the reference's cart drawer -->
    <aside class="as-added" id="as-added" role="dialog" aria-modal="false" aria-labelledby="as-added-title" aria-hidden="true" inert>
      <div class="as-added-head">
        <h2 id="as-added-title">Item added to your cart</h2>
        <button type="button" class="as-icon-btn" id="as-added-close" aria-label="Close">
          <svg viewBox="0 0 24 24"><path d="M6 6l12 12M18 6L6 18" /></svg>
        </button>
      </div>
      <div class="as-added-item">
        <img id="as-added-img" src="" alt="" width="96" height="120" />
        <div>
          <p class="as-added-name" id="as-added-name"></p>
          <p class="as-added-meta" id="as-added-meta"></p>
        </div>
      </div>
      <div class="as-added-actions">
        <a class="as-btn as-btn--solid" href="/cart">View cart</a>
        <a class="as-btn as-btn--outline" href="/checkout">Check out</a>
        <button type="button" class="as-added-continue" id="as-added-continue">Continue shopping</button>
      </div>
    </aside>

    <script>
      // CSRF shim — same contract as the legacy Layout (__AASRA_CSRF).
      (() => {
        const COOKIE_NAME = 'csrf_token';
        const getCookie = (name) => {
          const v = document.cookie.match('(?:^|;\\s*)' + name + '=([^;]*)');
          return v ? v[1] : '';
        };
        const setCookie = (name, value) => {
          document.cookie = name + '=' + value + '; Path=/; SameSite=Strict; Secure';
        };
        window.__AASRA_CSRF = {
          token: getCookie(COOKIE_NAME),
          async ensure() {
            if (this.token) return this.token;
            try {
              const res = await fetch('/api/csrf-token', { credentials: 'same-origin' });
              if (res.ok) {
                const data = await res.json();
                if (data.csrf_token) {
                  this.token = data.csrf_token;
                  setCookie(COOKIE_NAME, data.csrf_token);
                }
              }
            } catch (e) {}
            return this.token;
          },
          header() {
            return { 'X-CSRF-Token': this.token || '' };
          },
        };
      })();
    </script>
    <script>
      // Colour dots on cards (listing, home, Categories in Focus): show that colour's photo on the card.
      const showColour = (dot) => {
        const card = dot.closest('.as-card, .as-focus-card');
        const img = card && card.querySelector('.as-card-media img, .as-focus-img img');
        if (img) { img.src = dot.dataset.colourImage; img.removeAttribute('srcset'); }
        dot.parentElement.querySelectorAll('[data-colour-image]').forEach((d) => {
          const on = d === dot;
          d.classList.toggle('is-active', on);
          d.setAttribute('aria-pressed', on ? 'true' : 'false');
        });
        const map = card && card.dataset.colourSkus ? JSON.parse(card.dataset.colourSkus) : null;
        const skus = map && map[dot.dataset.colour];
        if (skus) card.querySelectorAll('[data-quick-add]').forEach((b) => { b.dataset.sku = skus[b.textContent.trim()] || ''; });
      };
      document.addEventListener('click', (e) => {
        const dot = e.target.closest('[data-colour-image]');
        if (!dot) return;
        e.preventDefault();
        e.stopPropagation();
        showColour(dot);
      });
      document.addEventListener('keydown', (e) => {
        if (e.key !== 'Enter' && e.key !== ' ') return;
        const dot = e.target.closest && e.target.closest('[data-colour-image]');
        if (!dot) return;
        e.preventDefault();
        showColour(dot);
      });
    </script>
    <script>
      // Cart shim — same contract as the legacy CartDrawer:
      // localStorage aasra_cart_v1 = [{ sku, name, price, qty, image }]
      (() => {
        const KEY = 'aasra_cart_v1';
        const read = () => { try { return JSON.parse(localStorage.getItem(KEY) || '[]'); } catch { return []; } };
        const write = (cart) => {
          localStorage.setItem(KEY, JSON.stringify(cart));
          window.dispatchEvent(new Event('aasra:cart'));
        };
        const panel = document.getElementById('as-added');
        const showAdded = (name, price, image) => {
          if (!panel) return;
          document.getElementById('as-added-name').textContent = name;
          document.getElementById('as-added-meta').textContent = `PKR ${Number(price).toLocaleString('en-PK')} · 1 in your bag`;
          const img = document.getElementById('as-added-img');
          img.src = image || '/images/placeholder.svg';
          img.alt = name;
          panel.classList.add('is-open');
          panel.removeAttribute('inert');
          panel.setAttribute('aria-hidden', 'false');
          document.getElementById('as-added-continue')?.focus();
        };
        const hideAdded = () => {
          if (!panel) return;
          panel.classList.remove('is-open');
          panel.setAttribute('inert', '');
          panel.setAttribute('aria-hidden', 'true');
        };
        document.getElementById('as-added-close')?.addEventListener('click', hideAdded);
        document.getElementById('as-added-continue')?.addEventListener('click', hideAdded);
        document.addEventListener('keydown', (e) => { if (e.key === 'Escape') hideAdded(); });
        window.__aasra_addToCart = (sku, name, price, qty = 1, image = '') => {
          const cart = read();
          const hit = cart.find((i) => i.sku === sku);
          if (hit) hit.qty += qty; else cart.push({ sku, name, price, qty, image });
          write(cart);
          showAdded(name, price, image);
        };
        window.addEventListener('aasra:cart:clear', () => write([]));
        // Same contract as the legacy CartDrawer, so bag pages work on the store layout.
        window.__AASRA_CART_KEY = KEY;
        window.__aasra_updateQty = (index, delta) => {
          const cart = read();
          if (!cart[index]) return;
          cart[index].qty = Math.max(1, (cart[index].qty || 1) + delta);
          write(cart);
        };
        window.__aasra_remove = (index) => {
          const cart = read();
          cart.splice(index, 1);
          write(cart);
        };
      })();

      // Reveal on scroll (design system §6), staggered via [data-stagger].
      (() => {
        const targets = document.querySelectorAll('.as-reveal');
        if (!('IntersectionObserver' in window)) {
          targets.forEach((t) => t.classList.add('is-in'));
          return;
        }
        const io = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-in');
              io.unobserve(entry.target);
            }
          });
        }, { threshold: 0.12, rootMargin: '0px 0px -6% 0px' });
        targets.forEach((t) => io.observe(t));
        document.querySelectorAll('[data-stagger]').forEach((group) => {
          [...group.children].forEach((child, i) => child.style.setProperty('--i', i));
        });
      })();

      // Cursor parallax for hero panels (±10px) and scroll parallax for campaign banners.
      (() => {
        if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        const campaigns = document.querySelectorAll('.as-campaign > img');
        if (campaigns.length) {
          const onScroll = () => {
            campaigns.forEach((img) => {
              const r = img.parentElement.getBoundingClientRect();
              const progress = (r.top + r.height / 2 - innerHeight / 2) / innerHeight;
              img.style.transform = `translateY(${progress * -40}px)`;
            });
          };
          window.addEventListener('scroll', onScroll, { passive: true });
          onScroll();
        }
      })();

      // Scrollable tables must be keyboard-reachable (axe: scrollable-region-focusable).
      (() => {
        document.querySelectorAll('main table').forEach((t) => {
          if (t.scrollWidth > t.clientWidth) { t.tabIndex = 0; t.setAttribute('role', 'region'); t.setAttribute('aria-label', 'Table, scroll sideways to see more'); }
        });
      })();
      // Scroll progress line (clay), tracks document scroll position.
      (() => {
        const bar = document.getElementById('as-progress');
        if (!bar) return;
        const update = () => {
          const max = document.documentElement.scrollHeight - innerHeight;
          bar.style.width = (max > 0 ? (scrollY / max) * 100 : 0) + '%';
        };
        window.addEventListener('scroll', update, { passive: true });
        update();
      })();
    </script>
  </body>
</html>
