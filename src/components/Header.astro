---
const isHome = Astro.url.pathname === '/';

// AASRA's own taxonomy arranged in the broad, multi-column editorial menu
// pattern observed in the reference. Only our original copy and imagery are used.
const shopMenuGroups = [
  { title: 'HOME TEXTILES', links: [
    { label: 'Curtains', href: '/shop?category=home-textiles' },
    { label: 'Cushions', href: '/shop?category=home-textiles' },
    { label: 'Throws & blankets', href: '/shop?category=home-textiles' },
    { label: 'Bedding', href: '/shop?category=home-textiles' },
    { label: 'All home textiles', href: '/shop?category=home-textiles' },
  ] },
  { title: 'RUGS', links: [
    { label: 'Cotton dhurries', href: '/shop?category=rugs' },
    { label: 'Woven rugs', href: '/shop?category=rugs' },
    { label: 'Small rugs', href: '/shop?category=rugs' },
    { label: 'All rugs', href: '/shop?category=rugs' },
  ] },
  { title: 'TABLE & KITCHEN', links: [
    { label: 'Dinnerware', href: '/shop?category=tableware' },
    { label: 'Serving pieces', href: '/shop?category=tableware' },
    { label: 'Table linens', href: '/shop?category=home-textiles' },
    { label: 'All tableware', href: '/shop?category=tableware' },
  ] },
  { title: 'OBJECTS & GIFTS', links: [
    { label: 'Woodware', href: '/shop?category=woodware' },
    { label: 'Gifts for the home', href: '/gifts' },
    { label: 'New arrivals', href: '/new-arrivals' },
    { label: 'The journal', href: '/journal' },
    { label: 'Shop all', href: '/shop' },
  ] },
];
const shopMenuStories = [
  { img: '/images/campaign/story-artisan.webp', title: 'Made by hand', href: '/about' },
  { img: '/images/campaign/gifts-table.webp', title: 'A considered table', href: '/shop?category=tableware' },
  { img: '/images/campaign/explore-collection.webp', title: 'The winter edit', href: '/shop' },
];

// Mega-menu data for category links.
const megas = {
  shop: {
    label: 'Shop',
    href: '/shop',
    links: [
      { label: 'Shop all', href: '/shop' },
      { label: 'Home Textiles', href: '/shop?category=home-textiles' },
      { label: 'Rugs', href: '/shop?category=rugs' },
      { label: 'Tableware', href: '/shop?category=tableware' },
      { label: 'Woodware', href: '/shop?category=woodware' },
      { label: 'Gifts', href: '/gifts' },
    ],
    feature: {
      img: '/images/campaign/explore-collection.webp',
      kicker: 'The Winter Edit',
      title: 'Explore the collection',
      href: '/shop',
    },
  },
  textiles: {
    label: 'Home Textiles',
    href: '/shop?category=home-textiles',
    links: [
      { label: 'Shop all textiles', href: '/shop?category=home-textiles' },
      { label: 'Linen Curtain Panel — Ivory', href: '/product/linen-curtain-panel-ivory' },
      { label: 'Linen Curtain Panel — Slate', href: '/product/linen-curtain-panel-slate' },
      { label: 'Linen Throw Cushion — Oatmeal', href: '/product/throw-cushion-linen-oatmeal' },
    ],
    feature: {
      img: '/images/products/cushion-oatmeal-2.webp',
      kicker: 'Home Textiles',
      title: 'Woven linen, made to stay',
      href: '/shop?category=home-textiles',
    },
  },
  rugs: {
    label: 'Rugs',
    href: '/shop?category=rugs',
    links: [
      { label: 'Shop all rugs', href: '/shop?category=rugs' },
      { label: 'Cotton Dhurrie Rug — Beige', href: '/product/cotton-dhurrie-rug-beige' },
      { label: 'Cotton Dhurrie Rug — Charcoal', href: '/product/cotton-dhurrie-rug-charcoal' },
    ],
    feature: {
      img: '/images/products/dhurrie-beige-2.webp',
      kicker: 'Handwoven',
      title: 'The dhurrie edit',
      href: '/shop?category=rugs',
    },
  },
  tableware: {
    label: 'Tableware',
    href: '/shop?category=tableware',
    links: [
      { label: 'Shop all tableware', href: '/shop?category=tableware' },
      { label: 'Ceramics Dinner Plate Set', href: '/product/ceramics-dinner-plate-set' },
      { label: 'Ceramics Serving Bowl — Large', href: '/product/ceramics-serving-bowl-large' },
    ],
    feature: {
      img: '/images/products/dinner-plate-2.webp',
      kicker: 'New collection',
      title: 'The Table Collection',
      href: '/shop?category=tableware',
    },
  },
  woodware: {
    label: 'Woodware',
    href: '/shop?category=woodware',
    links: [
      { label: 'Shop all woodware', href: '/shop?category=woodware' },
      { label: 'Teak Wooden Tray — Medium', href: '/product/wooden-tray-teak-medium' },
    ],
    feature: {
      img: '/images/products/teak-tray-2.webp',
      kicker: 'Solid teak',
      title: 'Carved by hand',
      href: '/shop?category=woodware',
    },
  },
  gifts: {
    label: 'Gifts',
    href: '/gifts',
    links: [
      { label: 'Gift Selection', href: '/gifts' },
      { label: 'Gifts for the home', href: '/shop?category=home-textiles' },
      { label: 'Gifts for the table', href: '/shop?category=tableware' },
      { label: 'Gifts for the kitchen', href: '/shop?category=woodware' },
    ],
    feature: {
      img: '/images/campaign/gifts-home.webp',
      kicker: 'Holiday Season',
      title: 'The gift edit',
      href: '/gifts',
    },
  },
};
---

<header class:list={["header", { "home-over-image": isHome }]} role="banner">
  <div class="announcement-bar" role="note">A quieter kind of home — considered essentials, thoughtfully made <a href="/shop">Discover the collection</a></div>
  <!-- Utility bar -->
  <div class="header-utility">
    <div class="container header-utility-inner">
      <button type="button" data-open-country class="header-utility-country" style="background:none; border:none; cursor:pointer; padding:0; font:inherit; color:inherit; letter-spacing:inherit; text-transform:inherit;">Pakistan (PKR)</button>
      <span class="header-utility-links">
        <a href="/services">Services</a>
        <a href="/contact">Contact us</a>
        <a href="/order-lookup">Order lookup</a>
        <a href="mailto:orders@aasra.shop" target="_blank" rel="noopener">Email</a>
      </span>
    </div>
  </div>

  <!-- Logotype row -->
  <div class="header-logo-row">
    <button class="menu-toggle" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-menu">
      <span></span><span></span><span></span>
    </button>

    <a href="/" class="logo" aria-label="AASRA home">AASRA</a>

    <div class="header-icons" aria-label="Utilities">
      <button id="search-btn" aria-label="Search" aria-expanded="false" aria-controls="search-row" title="Search" class="util-icon">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" aria-hidden="true">
          <circle cx="11" cy="11" r="7"/><path d="M16.5 16.5 21 21"/>
        </svg>
      </button>
      <a href="/wishlist" aria-label="Wishlist" title="Wishlist" class="util-icon">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" aria-hidden="true">
          <path d="M12 20.5C7 16.5 3.5 13.2 3.5 9.6 3.5 7 5.5 5 8 5c1.6 0 3.1.8 4 2.1C12.9 5.8 14.4 5 16 5c2.5 0 4.5 2 4.5 4.6 0 3.6-3.5 6.9-8.5 10.9Z"/>
        </svg>
      </a>
      <a href="/order-lookup" aria-label="Account and orders" title="Account and orders" class="util-icon">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" aria-hidden="true">
          <circle cx="12" cy="8" r="3.5"/><path d="M4.5 20c.6-4 3.2-6 7.5-6s6.9 2 7.5 6"/>
        </svg>
      </a>
      <button id="cart-btn" aria-label="Shopping cart" title="Cart" class="util-icon" style="position:relative;">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" aria-hidden="true">
          <path d="M5.5 8h13l-1 12.5h-11L5.5 8Z"/>
          <path d="M8.5 10V6.5a3.5 3.5 0 0 1 7 0V10"/>
        </svg>
      </button>
      <span id="cart-badge" class="cart-count" style="display:none;">0</span>
    </div>
  </div>

  <!-- Nav row with mega menus -->
  <nav class="header-nav" id="main-nav" aria-label="Main navigation">
    <ul class="nav-list">
      <li><a href="/">Home</a></li>
      <li class="nav-item">
        <a href={megas.shop.href}>{megas.shop.label}</a>
        <div class="mega mega-shop" aria-label="Shop categories">
          <div class="mega-shop-main">
            {shopMenuGroups.map((group) => (
              <section class="mega-shop-column">
                <h2>{group.title}</h2>
                <ul>{group.links.map((link) => <li><a href={link.href}>{link.label}</a></li>)}</ul>
              </section>
            ))}
          </div>
          <div class="mega-shop-stories">
            {shopMenuStories.map((story) => (
              <a class="mega-shop-story" href={story.href}>
                <span class="mega-shop-story-title">{story.title}</span>
                <img src={story.img} alt={story.title} loading="lazy" width="600" height="750" />
                <span class="mega-shop-story-link">Discover more</span>
              </a>
            ))}
          </div>
          <a class="mega-shop-discover" href="/shop">Discover the collection</a>
        </div>
      </li>
      <li class="nav-item">
        <a href={megas.textiles.href}>{megas.textiles.label}</a>
        <div class="mega">
          <div class="mega-links">
            <span class="small-caps">Home Textiles</span>
            <ul>
              {megas.textiles.links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
            </ul>
          </div>
          <a href={megas.textiles.feature.href} class="mega-feature">
            <img src={megas.textiles.feature.img} alt={megas.textiles.feature.title} loading="lazy" width="600" height="750" />
            <figcaption>
              <span class="small-caps">{megas.textiles.feature.kicker}</span>
              <span class="mega-feature-title">{megas.textiles.feature.title}</span>
            </figcaption>
          </a>
        </div>
      </li>
      <li class="nav-item">
        <a href={megas.rugs.href}>{megas.rugs.label}</a>
        <div class="mega">
          <div class="mega-links">
            <span class="small-caps">Rugs</span>
            <ul>
              {megas.rugs.links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
            </ul>
          </div>
          <a href={megas.rugs.feature.href} class="mega-feature">
            <img src={megas.rugs.feature.img} alt={megas.rugs.feature.title} loading="lazy" width="600" height="750" />
            <figcaption>
              <span class="small-caps">{megas.rugs.feature.kicker}</span>
              <span class="mega-feature-title">{megas.rugs.feature.title}</span>
            </figcaption>
          </a>
        </div>
      </li>
      <li class="nav-item">
        <a href={megas.tableware.href}>{megas.tableware.label}</a>
        <div class="mega">
          <div class="mega-links">
            <span class="small-caps">Tableware</span>
            <ul>
              {megas.tableware.links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
            </ul>
          </div>
          <a href={megas.tableware.feature.href} class="mega-feature">
            <img src={megas.tableware.feature.img} alt={megas.tableware.feature.title} loading="lazy" width="600" height="750" />
            <figcaption>
              <span class="small-caps">{megas.tableware.feature.kicker}</span>
              <span class="mega-feature-title">{megas.tableware.feature.title}</span>
            </figcaption>
          </a>
        </div>
      </li>
      <li class="nav-item">
        <a href={megas.woodware.href}>{megas.woodware.label}</a>
        <div class="mega">
          <div class="mega-links">
            <span class="small-caps">Woodware</span>
            <ul>
              {megas.woodware.links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
            </ul>
          </div>
          <a href={megas.woodware.feature.href} class="mega-feature">
            <img src={megas.woodware.feature.img} alt={megas.woodware.feature.title} loading="lazy" width="600" height="750" />
            <figcaption>
              <span class="small-caps">{megas.woodware.feature.kicker}</span>
              <span class="mega-feature-title">{megas.woodware.feature.title}</span>
            </figcaption>
          </a>
        </div>
      </li>
      <li class="nav-item">
        <a href={megas.gifts.href}>{megas.gifts.label}</a>
        <div class="mega">
          <div class="mega-links">
            <span class="small-caps">Gifts</span>
            <ul>
              {megas.gifts.links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
            </ul>
          </div>
          <a href={megas.gifts.feature.href} class="mega-feature">
            <img src={megas.gifts.feature.img} alt={megas.gifts.feature.title} loading="lazy" width="600" height="750" />
            <figcaption>
              <span class="small-caps">{megas.gifts.feature.kicker}</span>
              <span class="mega-feature-title">{megas.gifts.feature.title}</span>
            </figcaption>
          </a>
        </div>
      </li>
      <li><a href="/about">About</a></li>
    </ul>
  </nav>

  <!-- Full-screen, keyboard-dismissable search overlay -->
  <div class="header-search-row" id="search-row" role="dialog" aria-modal="true" aria-label="Search AASRA" aria-hidden="true" inert>
    <button type="button" class="search-close" id="search-close" aria-label="Close search">&times;</button>
    <form action="/shop" method="GET" role="search">
      <label class="small-caps" for="site-search">What are you looking for?</label>
      <input id="site-search" type="search" name="q" placeholder="Search products…" aria-label="Search products" autocomplete="off" />
      <button type="submit">Search</button>
    </form>
    <p>Explore home textiles, rugs, tableware and objects.</p>
  </div>
</header>

<script>
  const searchBtn = document.getElementById('search-btn');
  const searchRow = document.getElementById('search-row');
  const searchClose = document.getElementById('search-close');
  function closeSearch() {
    searchRow?.classList.remove('open');
    searchRow?.setAttribute('aria-hidden', 'true');
    searchRow?.setAttribute('inert', '');
    searchBtn?.setAttribute('aria-expanded', 'false');
    document.body.style.overflow = '';
    searchBtn?.focus();
  }
  if (searchBtn && searchRow) {
    searchBtn.addEventListener('click', () => {
      searchRow.classList.add('open');
      searchRow.removeAttribute('inert');
      searchRow.setAttribute('aria-hidden', 'false');
      searchBtn.setAttribute('aria-expanded', 'true');
      document.body.style.overflow = 'hidden';
      window.setTimeout(() => searchRow.querySelector('input')?.focus(), 80);
    });
    searchClose?.addEventListener('click', closeSearch);
    searchRow.addEventListener('click', (event) => { if (event.target === searchRow) closeSearch(); });
    document.addEventListener('keydown', (event) => { if (event.key === 'Escape' && searchRow.classList.contains('open')) closeSearch(); });
  }
</script>
