---
import Layout from '../components/Layout.astro';
---

<Layout title="Return & Refund Policy — AASRA" description="Return and refund terms.">
  <section class="section">
    <div class="container" style="max-width:720px;">
      <h1>Return &amp; Refund Policy</h1>
      <p><strong>Last updated:</strong> November 2026</p>
      <ul>
        <li>Returns accepted within 7 days of delivery.</li>
        <li>Items must be unused and in original packaging.</li>
        <li>Refunds are issued to the original payment method after we receive and inspect the item.</li>
        <li>Return shipping is paid by the customer unless the item is damaged or incorrect.</li>
        <li>Deposit-paid orders: the deposit is refunded per the Deposit &amp; Cancellation Policy.</li>
      </ul>
      <p>This is a summary policy. Replace with full legal text reviewed by a lawyer before launch.</p>
    </div>
  </section>
</Layout>
