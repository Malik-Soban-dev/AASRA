---
import Layout from '../../components/Layout.astro';
import ProductCard from '../../components/ProductCard.astro';
import { formatPKR, depositAmount, balanceAmount } from '../../lib/products.js';
import productsData from '../../../data/products.json';

export function getStaticPaths() {
  return productsData.products
    .filter((p) => p.visible)
    .map((p) => ({ params: { slug: p.slug } }));
}

const slug = Astro.params.slug;
const product = productsData.products.find((p) => p.slug === slug);

if (!product) {
  return Astro.redirect('/404');
}

const firstImage = product.images[0] || '/images/placeholder.svg';
const defaultVariant = product.variants[0];
const DEPOSIT_PERCENT = 30; // VERIFY: must match backend DEFAULT_DEPOSIT_PERCENT
const estimatedDeposit = product.deposit_eligible ? depositAmount(product.price_pkr, DEPOSIT_PERCENT) : 0;
const estimatedBalance = product.deposit_eligible ? balanceAmount(product.price_pkr, estimatedDeposit) : 0;
---

<Layout title={product.name} description={product.seo?.description || product.description}>

  <section class="section">
    <div class="container">
      <div style="display:flex; gap:2rem; align-items:flex-start;">
        <!-- Gallery: stacked editorial images (BC pattern) -->
        <div class="product-gallery">
          <div class="pdp-gallery-stack">
            <img id="main-img" src={firstImage} alt={product.name} loading="eager" width="900" height="1125" />
          </div>
          <div class="thumbs" role="group" aria-label="Product images">
            {product.images.map((img, index) => (
              <button class:list={["thumb", { selected: index === 0 }]} type="button" data-img={img} aria-label={`View image ${index + 1}`} aria-pressed={index === 0}>
                <img src={img} alt="" loading="lazy" width="90" height="90" />
              </button>
            ))}
          </div>
        </div>

        <!-- Meta (sticky info column, BC-style) -->
        <div class="product-meta pdp-info">
          <div class="kicker" style="margin-bottom:0.5rem;">
            {product.category.charAt(0).toUpperCase() + product.category.slice(1)}
          </div>
          <h1 class="product-title">{product.name}</h1>
          <div class="product-price-display">{formatPKR(product.price_pkr)}</div>
          <div class="product-color-display">
            {defaultVariant?.size ? defaultVariant.size : ''}
            {product.variants.length > 1 ? ` · ${product.variants.length} variants` : ''}
          </div>

          <p style="font-size:0.85rem; color:var(--muted); margin-bottom:1.5rem;">
            {product.description}
          </p>

          <!-- Size selector -->
          <div class="size-group">
            <span class="size-label">Select your size</span>
            <div class="size-options" id="size-options">
              {product.variants.map((v) => (
                <button
                  class="size-btn"
                  data-sku={v.sku}
                  data-size={v.size}
                >
                  {v.size}
                </button>
              ))}
            </div>
          </div>

          <!-- Deposit note -->
          {product.deposit_eligible && (
            <div class="deposit-note">
              <strong>Pay in instalments:</strong> Deposit {DEPOSIT_PERCENT}% = {formatPKR(estimatedDeposit)}, balance {formatPKR(estimatedBalance)} due online before shipping.
            </div>
          )}

          <div class="actions">
            <div class="qty-selector">
              <button type="button" id="qty-minus">−</button>
              <input type="number" id="qty" value="1" min="1" max="10" />
              <button type="button" id="qty-plus">+</button>
            </div>
            <button id="add-to-cart" class="btn btn-primary btn-full" data-name={product.name} data-price={product.price_pkr} data-sku={defaultVariant.sku} data-image={product.images[0]}>Add to cart</button>
            <button id="wishlist-toggle" class="btn btn-full" data-default-sku={defaultVariant?.sku || product.id} style="margin-top:0.5rem;">⤖ Add to wishlist</button>
          </div>

          <div class="stock-note" id="stock-note">Availability confirmed when your order is reviewed.</div>

          <div style="display:flex; justify-content:space-between; margin-top:0.9rem;">
            <a href="/size-guide" class="text-link">Size Guide</a>
            <a href="/contact" class="text-link">May we help you?</a>
          </div>

          <div class="service-links" style="justify-content:flex-start;">
            <a href="mailto:orders@aasra.shop" target="_blank" rel="noopener">Email us about this piece</a>
            <a href="/order-lookup">Track your order</a>
            <a href="/boutiques">Find in boutique</a>
          </div>

          <!-- Accordions (BC-style hairline details) -->
          <details class="accordion" open style="margin-top:1.8rem;">
            <summary>Description</summary>
            <div class="accordion-body">
              <p>{product.description}</p>
              <p style="margin-top:0.5rem;"><strong>Care:</strong> Handle with care. Spot clean where possible.</p>
              <p style="margin-top:0.5rem;">Category: {product.category.charAt(0).toUpperCase() + product.category.slice(1).replace('-', ' ')}</p>
            </div>
          </details>
          <details class="accordion">
            <summary>Packaging</summary>
            <div class="accordion-body">
              <p>Each piece arrives in protective, considered packaging. Gift wrapping in natural linen with a handwritten note is available on request — mention it in the order notes at checkout.</p>
            </div>
          </details>
          <details class="accordion">
            <summary>Shipping &amp; returns</summary>
            <div class="accordion-body">
              <p>Shipping calculated at checkout by city. Complimentary shipping on orders above Rs 20,000.</p>
              <p>Returns accepted within 7 days of delivery, unused and in original packaging. See the <a href="/return-policy">Return &amp; Refund Policy</a>.</p>
            </div>
          </details>
          <details class="accordion">
            <summary>Payment &amp; deposit</summary>
            <div class="accordion-body">
              <p><strong>No Cash on Delivery.</strong> Online checkout is not available until gateway setup is complete. Please contact us for current ordering options. See the <a href="/deposit-policy">Deposit Policy</a>.</p>
            </div>
          </details>
        </div>
      </div>
    </div>
  </section>

  <div class="pdp-sticky-bar" id="pdp-sticky-bar" aria-hidden="true">
    <span>{product.name}<small>{formatPKR(product.price_pkr)}</small></span>
    <button type="button" class="btn btn-primary" id="sticky-add-to-cart">Add to selection</button>
  </div>

  <!-- Meet our style advisors (BC pattern) -->
  <section class="section-tight advisor-band">
    <div class="container">
      <div class="split-grid">
        <div>
          <img src="/images/campaign/gifts-home.webp" alt="Style advisors" loading="lazy" width="900" height="1125" style="width:100%; aspect-ratio:16/10; object-fit:cover; display:block;" />
        </div>
        <div style="display:flex; flex-direction:column; justify-content:center; text-align:center; gap:1rem;">
          <h3 style="font-size:1.6rem;">Meet our style advisors</h3>
          <p style="color:var(--muted); line-height:1.85; max-width:46ch; margin:0 auto;">
            We are available to help you with styling suggestions and inspiration tailored
            for you — in the Karachi studio, or by video call.
          </p>
          <div class="hero-links" style="justify-content:center;">
            <a href="/appointment" style="color:var(--text); border-bottom-color:var(--text);">Book an appointment</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Share (BC pattern: SHARE row under product content) -->
  <section class="section-tight" style="text-align:center; border-top:1px solid var(--border);">
    <div class="container">
      <div class="kicker" style="margin-bottom:1.2rem;">Share</div>
      <div class="share-row">
        <a id="share-wa" href="#" target="_blank" rel="noopener">Email</a>
        <a id="share-mail" href="#">Email</a>
        <button type="button" id="share-copy">Copy link</button>
      </div>
    </div>
  </section>

  <script is:inline>
    // @ts-nocheck -- browser-only event handlers use DOM APIs guarded at runtime.
    (function () {
      var url = window.location.href;
      var title = document.title;
      var wa = document.getElementById('share-wa');
      var mail = document.getElementById('share-mail');
      var copy = document.getElementById('share-copy');
      if (wa) wa.href = 'https://wa.me/?text=' + encodeURIComponent(title + ' — ' + url);
      if (mail) mail.href = 'mailto:?subject=' + encodeURIComponent(title) + '&body=' + encodeURIComponent(url);
      if (copy) copy.addEventListener('click', function () {
        navigator.clipboard?.writeText(url).then(function () {
          copy.textContent = 'Copied';
          setTimeout(function () { copy.textContent = 'Copy link'; }, 1600);
        });
      });
    })();
  </script>

  <!-- Complete the look -->
  <section class="cross-sell">
    <div class="container">
      <h3>You may also be interested in</h3>
      <div class="grid">
        {productsData.products
          .filter((p) => p.visible && p.id !== product.id && p.category === product.category)
          .slice(0, 4)
          .map((p) => <ProductCard product={p} />)}
      </div>
    </div>
  </section>

  <script>
    // @ts-nocheck -- browser-only event handlers use DOM APIs guarded at runtime.
    // Gallery thumb click
    const mainImg = document.getElementById('main-img');
    const thumbs = document.querySelectorAll('.thumb');
    thumbs.forEach((t) => {
      t.addEventListener('click', () => {
        thumbs.forEach((x) => { x.classList.remove('selected'); x.setAttribute('aria-pressed', 'false'); });
        t.classList.add('selected');
        t.setAttribute('aria-pressed', 'true');
        mainImg.classList.remove('zoomed');
        mainImg.src = t.getAttribute('data-img');
      });
    });

    // Tap/click the primary image to toggle a simple detail zoom.
    mainImg?.addEventListener('click', () => mainImg.classList.toggle('zoomed'));
    const stickyBar = document.getElementById('pdp-sticky-bar');
    const primaryAdd = document.getElementById('add-to-cart');
    const stickyAdd = document.getElementById('sticky-add-to-cart');
    stickyAdd?.addEventListener('click', () => primaryAdd?.click());
    if (primaryAdd && stickyBar && 'IntersectionObserver' in window) {
      const stickyObserver = new IntersectionObserver(([entry]) => {
        const show = !entry.isIntersecting && window.scrollY > 240;
        stickyBar.classList.toggle('visible', show);
        stickyBar.setAttribute('aria-hidden', String(!show));
      });
      stickyObserver.observe(primaryAdd);
    }

    // Size selection
    const sizeBtns = document.querySelectorAll('.size-btn');
    let selectedSku = sizeBtns[0]?.getAttribute('data-sku') || '';
    sizeBtns.forEach((b) => {
      b.addEventListener('click', () => {
        sizeBtns.forEach((x) => x.classList.remove('selected'));
        b.classList.add('selected');
        selectedSku = b.getAttribute('data-sku');
      });
    });

    // Qty controls
    const qtyInput = document.getElementById('qty');
    document.getElementById('qty-minus')?.addEventListener('click', () => {
      const v = Math.max(1, parseInt(qtyInput.value) - 1);
      qtyInput.value = v;
    });
    document.getElementById('qty-plus')?.addEventListener('click', () => {
      const v = Math.min(10, parseInt(qtyInput.value) + 1);
      qtyInput.value = v;
    });

    // Add to cart (reads from data attributes, safe against special chars)
    const addBtn = document.getElementById('add-to-cart');
    addBtn?.addEventListener('click', () => {
      const qty = parseInt(qtyInput.value) || 1;
      const sku = selectedSku || addBtn.getAttribute('data-sku');
      const name = addBtn.getAttribute('data-name');
      const price = parseInt(addBtn.getAttribute('data-price')) || 0;
      if (!sku) return;
      const btn = document.getElementById('add-to-cart');
      const original = btn.textContent;
      btn.textContent = 'Added';
      btn.style.opacity = '0.7';
      setTimeout(() => { btn.textContent = original; btn.style.opacity = '1'; }, 1000);
      window.__aasra_addToCart(sku, name, price, qty, addBtn.getAttribute('data-image') || '');
    });

    // Wishlist toggle (localStorage)
    const wishBtn = document.getElementById('wishlist-toggle');
    const WL_KEY = window.__AASRA_WISHLIST_KEY || 'aasra_wishlist_v1';
    function isWishlisted(sku) {
      try { return JSON.parse(localStorage.getItem(WL_KEY) || '[]').includes(sku); } catch { return false; }
    }
    function toggleWishlist(sku) {
      try {
        const wl = JSON.parse(localStorage.getItem(WL_KEY) || '[]');
        if (wl.includes(sku)) {
          const idx = wl.indexOf(sku);
          wl.splice(idx, 1);
        } else {
          wl.push(sku);
        }
        localStorage.setItem(WL_KEY, JSON.stringify(wl));
      } catch (e) {}
    }
    const defaultSku = wishBtn?.dataset.defaultSku || '';
    if (wishBtn) {
      if (isWishlisted(defaultSku)) wishBtn.textContent = '✔ In wishlist';
      wishBtn.addEventListener('click', () => {
        toggleWishlist(defaultSku);
        wishBtn.textContent = isWishlisted(defaultSku) ? '✔ In wishlist' : '⤖ Add to wishlist';
      });
    }
  </script>
</Layout>
