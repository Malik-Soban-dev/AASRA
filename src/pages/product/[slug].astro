---
/**
 * PDP — gallery (thumbs + zoom), colour/size selection, add to bag,
 * accordions, "wear it with" rail. Sticky add bar on mobile.
 */
import StoreLayout from '../../components/layout/StoreLayout.astro';
import ProductRail from '../../components/store/ProductRail.astro';
import { products, productBySlug, wearItWith, formatPrice, categoryLabel } from '../../lib/catalog.js';
import shippingRates from '../../../data/shipping-rates.json';

export function getStaticPaths() {
  return products.filter((p) => p.visible).map((p) => ({ params: { slug: p.slug } }));
}

const { slug } = Astro.params;
const product = productBySlug(slug);
if (!product) return Astro.redirect('/404');
const related = wearItWith(product);
const price = formatPrice(product.price_pkr);
const firstColor = product.colors[0];
const images = product.images.length > 1 ? product.images : [product.images[0], product.images[0]];
---

<StoreLayout title={`${product.name} — AASRA`}>
  <div class="container">
    <nav class="as-breadcrumb" aria-label="Breadcrumb">
      <a href="/">Home</a><span>/</span>
      <a href={`/${product.gender}`}>{product.gender === 'women' ? 'Women' : 'Men'}</a><span>/</span>
      <a href={`/${product.gender}/${product.category}`}>{categoryLabel(product.gender, product.category)}</a><span>/</span>
      <span aria-current="page">{product.name}</span>
    </nav>

    <div class="as-pdp">
      <div class="as-pdp-gallery">
        <div class="as-thumbs" role="group" aria-label="Product images">
          {images.map((img, i) => (
            <button type="button" class:list={['as-thumb', { 'is-active': i === 0 }]} data-full={img} aria-label={`View ${i + 1}`}>
              <img src={img} alt="" loading="lazy" width="76" height="101" />
            </button>
          ))}
        </div>
        <div class="as-pdp-main">
          {product.badge && <span class:list={['as-badge', { 'as-badge--clay': product.badge === 'LIMITED' }]}>{product.badge}</span>}
          <img id="as-pdp-main-img" src={images[0]} alt={product.name} width="900" height="1200" fetchpriority="high" />
        </div>
      </div>

      <div class="as-pdp-info">
        <p class="as-kicker">{product.fabric || 'Natural fibres'}</p>
        <h1 class="as-display-l">{product.name}</h1>
        <p class="as-pdp-price">{price}</p>
        <p class="as-muted" style="margin-top:var(--as-s4);max-width:44ch">{product.description}</p>

        <div class="as-pdp-attr">
          <span class="as-kicker">Colour — <span id="as-color-name">{firstColor.name}</span></span>
          <div class="as-swatches">
            {product.colors.map((c, i) => (
              <button type="button" class:list={['as-swatch', { 'is-active': i === 0 }]}
                style={`background:${c.hex}`} data-color={c.name} aria-label={`Colour: ${c.name}`}></button>
            ))}
          </div>
        </div>

        <div class="as-pdp-attr">
          <span class="as-kicker">Select your size</span>
          <div class="as-sizes" id="as-size-row">
            {product.sizes.map((size) => {
              const variant = product.variants.find((v) => v.size === size && v.color === firstColor.name);
              return (
                <button type="button" class="as-size" data-size={size} data-sku={variant?.sku}>{size}</button>
              );
            })}
          </div>
          <p class="as-muted" style="margin-top:var(--as-s3);font-size:.8rem">
            True to size. Between sizes? Take the larger. <a href="/size-guide" style="text-decoration:underline">Size guide</a>
          </p>
        </div>

        <div class="as-pdp-actions">
          <button type="button" class="as-btn as-btn--solid as-btn--block" id="as-add-btn" disabled>Select a size</button>
          <a class="as-link" href="/shipping" style="justify-self:center">Shipping & returns</a>
          <ul class="as-pdp-reassure" aria-label="Shipping and returns at a glance">
            <li>Complimentary shipping on orders above Rs {shippingRates.free_shipping_threshold_pkr.toLocaleString()}</li>
            <li>Returns accepted within 7 days of delivery</li>
            <li>Final-sale items are marked on the product page</li>
          </ul>
        </div>

        <div class="as-accordion">
          {product.details?.length > 0 && (
            <details class="as-accordion-item" open>
              <summary>Details</summary>
              <ul class="as-accordion-body">
                {product.details.map((d) => <li>{d}</li>)}
              </ul>
            </details>
          )}
          <details class="as-accordion-item">
            <summary>Fabric & care</summary>
            <div class="as-accordion-body">
              <p>{product.fabric}</p>
              <p style="margin-top:.5rem">{product.care}</p>
            </div>
          </details>
          <details class="as-accordion-item">
            <summary>Shipping & returns</summary>
            <div class="as-accordion-body">
              <p>Dispatched within 2–4 working days from Lahore. Complimentary shipping over PKR 10,000.</p>
              <p style="margin-top:.5rem">Easy exchanges within 14 days. See <a href="/return-policy" style="text-decoration:underline">returns policy</a>.</p>
            </div>
          </details>
        </div>
      </div>
    </div>
  </div>

  <ProductRail
    kicker="Styled with"
    title="Wear it with"
    products={related}
    link={{ label: 'Shop all', href: `/${product.gender}` }}
  />

  <div class="as-stickybar is-on" id="as-stickybar">
    <div>
      <p class="as-serif" style="font-size:.95rem">{product.name}</p>
      <p class="as-price">{price}</p>
    </div>
    <button type="button" class="as-btn as-btn--solid" id="as-sticky-add" disabled>Select a size</button>
  </div>

  <script define:vars={{ productData: product }}>
    // Gallery thumbs, colour/size selection, add to bag via the shared cart API.
    const mainImg = document.getElementById('as-pdp-main-img');
    document.querySelectorAll('.as-thumb').forEach((btn) => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('.as-thumb').forEach((b) => b.classList.remove('is-active'));
        btn.classList.add('is-active');
        mainImg.src = btn.dataset.full;
      });
    });

    let color = productData.colors[0].name;
    let size = null;
    const addBtn = document.getElementById('as-add-btn');
    const stickyAdd = document.getElementById('as-sticky-add');
    const skuFor = () => productData.variants.find((v) => v.size === size && v.color === color)?.sku;

    // The bag is the source of truth: if this SKU is already in it (from this
    // visit, an earlier visit, or another tab), say so and never add it again.
    const CART_KEY = 'aasra_cart_v1';
    const inBag = (sku) => {
      try {
        return JSON.parse(localStorage.getItem(CART_KEY) || '[]').some((i) => i.sku === sku);
      } catch {
        return false;
      }
    };

    const refresh = () => {
      const sku = skuFor();
      const isInBag = !!sku && inBag(sku);
      addBtn.textContent = !size ? 'Select a size' : isInBag ? 'Already in your bag — view bag' : `Add to bag — ${size}`;
      stickyAdd.textContent = !size ? 'Select a size' : isInBag ? 'In your bag' : 'Add to bag';
      addBtn.disabled = !size;
      stickyAdd.disabled = !size;
    };

    document.querySelectorAll('.as-swatch').forEach((sw) => {
      sw.addEventListener('click', () => {
        color = sw.dataset.color;
        document.getElementById('as-color-name').textContent = color;
        document.querySelectorAll('.as-swatch').forEach((s) => s.classList.remove('is-active'));
        sw.classList.add('is-active');
        // Refresh SKU mapping for the new colour.
        document.querySelectorAll('#as-size-row .as-size').forEach((btn) => {
          const variant = productData.variants.find((v) => v.size === btn.dataset.size && v.color === color);
          btn.dataset.sku = variant?.sku;
        });
        refresh();
      });
    });

    // Colour chosen on a card (?colour=Clay) opens with that colour preselected.
    const presetColour = new URLSearchParams(location.search).get('colour');
    if (presetColour) document.querySelector(`.as-swatch[data-color="${CSS.escape(presetColour)}"]`)?.click();

    document.querySelectorAll('#as-size-row .as-size').forEach((btn) => {
      btn.addEventListener('click', () => {
        size = btn.dataset.size;
        document.querySelectorAll('#as-size-row .as-size').forEach((b) => b.classList.remove('is-active'));
        btn.classList.add('is-active');
        refresh();
      });
    });

    const addToBag = () => {
      const sku = skuFor();
      if (!sku) return;
      if (inBag(sku)) {
        window.location.href = '/cart';
        return;
      }
      window.__aasra_addToCart?.(sku, productData.name, productData.price_pkr, 1, productData.images[0]);
      refresh();
    };
    addBtn.addEventListener('click', addToBag);
    stickyAdd.addEventListener('click', addToBag);
    // Keep the label honest when the bag changes elsewhere or the page is restored from history.
    window.addEventListener('storage', refresh);
    window.addEventListener('aasra:cart', refresh);
    window.addEventListener('pageshow', refresh);
    refresh();
  </script>
</StoreLayout>
