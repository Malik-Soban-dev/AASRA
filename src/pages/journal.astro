---
import Layout from '../components/Layout.astro';

const stories = [
  {
    slug: 'the-dhurrie',
    title: 'The dhurrie: five weeks on the loom',
    excerpt: 'From cotton thread to flat-woven rug — what handweaving actually asks of the hands that do it.',
    img: '/images/campaign/story-artisan.webp',
    kicker: 'Craft',
  },
  {
    slug: 'caring-for-linen',
    title: 'Caring for linen',
    excerpt: 'Wash cool, line-dry, and never fear the crease: a short guide to living with pure linen.',
    img: '/images/products/linen-curtain-ivory-2.webp',
    kicker: 'Care',
  },
  {
    slug: 'the-winter-table',
    title: 'Setting a winter table',
    excerpt: 'Candlelight, stoneware, and the case for long dinners — composing a table for the season.',
    img: '/images/campaign/banner-table.webp',
    kicker: 'At home',
  },
];
---

<Layout title="Journal — AASRA" description="Stories from the AASRA world — craft, care, and life at home.">
  <div class="page-title-block">
    <div class="kicker">Stories</div>
    <h1>Journal</h1>
    <p class="page-sub">Notes on craft, care, and the life of objects at home.</p>
  </div>

  <section class="section-tight">
    <div class="container">
      <div class="journal-grid" data-stagger>
        {stories.map((s) => (
          <a href={`/journal/${s.slug}`} class="journal-card">
            <span class="tile-frame">
              <img src={s.img} alt={s.title} loading="lazy" width="600" height="750" />
            </span>
            <span class="kicker" style="display:block; margin-top:1.1rem;">{s.kicker}</span>
            <span class="journal-title">{s.title}</span>
            <span class="journal-excerpt">{s.excerpt}</span>
            <span class="text-link" style="margin-top:0.9rem;">Read</span>
          </a>
        ))}
      </div>
    </div>
  </section>
</Layout>

<style>
  .journal-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 2.5rem 1.5rem; }
  .journal-card { display: flex; flex-direction: column; }
  .journal-card:hover { opacity: 1; }
  .journal-title { font-family: var(--serif); font-size: 1.4rem; color: var(--text); margin-top: 0.45rem; line-height: 1.3; }
  .journal-excerpt { color: var(--muted); font-size: 0.875rem; line-height: 1.7; margin-top: 0.45rem; }
  @media (max-width: 820px) { .journal-grid { grid-template-columns: 1fr; } }
</style>
