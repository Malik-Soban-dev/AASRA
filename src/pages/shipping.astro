---
import Layout from '../components/Layout.astro';
---

<Layout title="Shipping Information — AASRA" description="Shipping rates, delivery estimates, and courier info for Pakistan.">
  <section class="section">
    <div class="container" style="max-width:640px;">
      <h1>Shipping Information</h1>
      <p>We ship across Pakistan via TCS. Rates are flat by city and shown at checkout.</p>
      <ul>
        <li><strong>Free shipping</strong> on orders above 20,000 PKR.</li>
        <li><strong>Dispatch:</strong> within 2 business days of payment confirmation.</li>
        <li><strong>Delivery:</strong> 2–7 days depending on city.</li>
        <li><strong>No Cash on Delivery.</strong> Pay in full online, or deposit + balance online before shipping.</li>
        <li>Orders paid by deposit ship only after the balance is paid in full.</li>
      </ul>
      <p>Tracking is provided once your order ships. Use <a href="/order-lookup">Order Lookup</a> to check status.</p>
    </div>
  </section>
</Layout>
