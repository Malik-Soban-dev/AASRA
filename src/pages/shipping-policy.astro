---
import Layout from '../components/Layout.astro';
---

<Layout title="Shipping & Delivery Policy — AASRA" description="Shipping rates and delivery terms.">
  <section class="section">
    <div class="container" style="max-width:720px;">
      <h1>Shipping &amp; Delivery Policy</h1>
      <p><strong>Last updated:</strong> November 2026</p>
      <ul>
        <li><strong>Courier:</strong> TCS across Pakistan.</li>
        <li><strong>Free shipping:</strong> on orders above 20,000 PKR.</li>
        <li><strong>Flat rates:</strong> by city, shown at checkout.</li>
        <li><strong>Dispatch:</strong> within 2 business days of payment confirmation.</li>
        <li><strong>Delivery estimate:</strong> 2–7 days depending on city.</li>
        <li>Deposit orders ship only after the balance is paid in full.</li>
        <li>Tracking provided once shipped.</li>
      </ul>
      <p>Rates and cities subject to change. Confirm current courier rates before launch.</p>
    </div>
  </section>
</Layout>
