---
import Layout from '../components/Layout.astro';
---

<Layout title="Order received — AASRA" description="Thank you for your order.">

  <section class="section">
    <div class="container" style="max-width:560px;">
      <h1>Order received</h1>
      <p>Thank you. Your order has been placed and is awaiting payment confirmation.</p>
      <p><strong>Important:</strong> The payment confirmation arrives via our payment gateway. You will receive an email once the payment is verified.</p>
      <div style="margin-top:2rem;">
        <a href="/order-lookup" class="btn">Track your order</a>
        <a href="/" class="btn">Back to shop</a>
      </div>
    </div>
  </section>
  <script is:inline>
    // The order is placed once the shopper reaches this page, so empty the cart.
    try {
      if (new URLSearchParams(location.search).get('order')) {
        localStorage.removeItem('aasra_cart_v1');
        window.dispatchEvent(new Event('aasra:cart'));
      }
    } catch (e) {}
  </script>
</Layout>
