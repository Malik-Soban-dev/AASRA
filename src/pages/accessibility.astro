---
import Layout from '../components/Layout.astro';
---

<Layout title="Accessibility Statement — AASRA" description="Accessibility information.">
  <section class="section">
    <div class="container" style="max-width:720px;">
      <h1>Accessibility Statement</h1>
      <p><strong>Last updated:</strong> November 2026</p>
      <p>AASRA is committed to an accessible shopping experience for everyone. We aim to meet WCAG 2.1 AA, including:</p>
      <ul>
        <li>Keyboard navigation and visible focus indicators</li>
        <li>Alt text on product images</li>
        <li>Labeled form fields</li>
        <li>Sufficient color contrast</li>
        <li>Reduced-motion support</li>
      </ul>
      <p>If you encounter an accessibility barrier, please email orders@example.com.</p>
    </div>
  </section>
</Layout>
