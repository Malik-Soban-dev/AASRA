---
import Layout from '../components/Layout.astro';
---

<Layout title="Cookie Policy — AASRA" description="Cookie and tracking information.">
  <section class="section">
    <div class="container" style="max-width:720px;">
      <h1>Cookie Policy</h1>
      <p><strong>Last updated:</strong> November 2026</p>
      <p>AASRA uses essential cookies for the cart and session, and Cloudflare Web Analytics (privacy-friendly, no cookies). We do not use advertising or tracking cookies by default.</p>
      <h3>Your choices</h3>
      <p>You can disable non-essential cookies in your browser settings. Essential cookies (cart, session) are required for the store to function.</p>
      <p><a href="/privacy">Privacy Policy</a></p>
    </div>
  </section>
</Layout>
