---
/**
 * Shop — all products, filterable by category and search, sortable.
 * Store design system: same card, grid and chips as the category pages.
 * The site is statically built, so the query string (category, q, sort) is
 * applied in the browser. Every product is rendered once; the script hides,
 * sorts and counts them from the URL. Chips and sort keep real hrefs/URLs,
 * so every view is shareable and the back button works.
 */
import StoreLayout from '../components/layout/StoreLayout.astro';
import ProductCard from '../components/store/ProductCard.astro';
import { getCategories } from '../lib/products.js';
import productsData from '../../data/products.json';

const visible = productsData.products.filter((p) => p.visible);
const categories = getCategories(productsData);

const label = (cat) => cat.charAt(0).toUpperCase() + cat.slice(1).replace('-', ' ');
---

<StoreLayout title="Shop — AASRA" description="Browse the AASRA collection: handloom women's and men's clothing, made slowly in Pakistan. PKR.">
  <div class="container">
    <nav class="as-breadcrumb" aria-label="Breadcrumb">
      <a href="/">Home</a><span>/</span>
      <span aria-current="page">Shop</span>
    </nav>

    <header class="as-plp-head">
      <p class="as-kicker" id="as-count-head">The collection · {visible.length} {visible.length === 1 ? 'piece' : 'pieces'}</p>
      <h1 class="as-display-l" id="as-heading">Shop</h1>
      <p class="as-muted" style="max-width:52ch">Handloom and natural fibres, small runs, made close to home.</p>
    </header>

    <nav class="as-subcats" aria-label="Categories">
      <a class="as-chip is-active" href="/shop" data-cat="" aria-current="page">All</a>
      {categories.map((cat) => (
        <a class="as-chip" href={`/shop?category=${cat}`} data-cat={cat}>{label(cat)}</a>
      ))}
      <a class="as-chip" href="/gifts">Gifts</a>
    </nav>

    <div class="as-filterbar">
      <div class="as-filter-group">
        <label class="as-filter-legend" for="sort-select">Sort</label>
        <select class="as-sort" id="sort-select" aria-label="Sort products">
          <option value="" selected>Featured</option>
          <option value="price-asc">Price: low to high</option>
          <option value="price-desc">Price: high to low</option>
          <option value="name">Name A–Z</option>
        </select>
      </div>
    </div>

    <p class="as-kicker" id="as-count-items" style="margin:var(--as-s4) 0" aria-live="polite">{visible.length} {visible.length === 1 ? 'item' : 'items'}</p>

    <div class="as-grid" id="as-grid">
      {visible.map((p, i) => (
        <div class="as-reveal as-grid-item" style={`--i:${i}`} data-cat={p.category} data-name={p.name} data-price={p.price_pkr} data-search={[p.name, p.description, ...(p.tags || [])].join('\n').toLowerCase()}>
          <ProductCard product={p} />
        </div>
      ))}
      <div class="as-empty" id="as-empty" style="display:none">
        <h2 class="as-h2">Nothing matches yet</h2>
        <p class="as-muted">Try another category, or see what just landed.</p>
        <p style="margin-top:var(--as-s5)"><a class="as-btn as-btn--outline" href="/women/new-in">New in</a></p>
      </div>
    </div>
  </div>

  <script>
    const grid = document.getElementById('as-grid');
    const items = grid ? [...grid.querySelectorAll('.as-grid-item')] : [];
    const empty = document.getElementById('as-empty');
    const heading = document.getElementById('as-heading');
    const countHead = document.getElementById('as-count-head');
    const countItems = document.getElementById('as-count-items');
    const sortSel = document.getElementById('sort-select');
    const chips = [...document.querySelectorAll('.as-subcats .as-chip[data-cat]')];

    const plural = (n, one, many) => `${n} ${n === 1 ? one : many}`;

    function readState() {
      const u = new URL(window.location.href);
      return {
        cat: u.searchParams.get('category') || '',
        q: (u.searchParams.get('q') || '').trim(),
        sort: u.searchParams.get('sort') || '',
      };
    }

    function apply() {
      if (!grid) return;
      const s = readState();
      const needle = s.q.toLowerCase();

      const shown = items.filter(
        (el) =>
          (!s.cat || el.dataset.cat === s.cat) &&
          (!needle || el.dataset.search.includes(needle))
      );

      let ordered = items.slice();
      if (s.sort === 'price-asc') ordered.sort((a, b) => Number(a.dataset.price) - Number(b.dataset.price));
      else if (s.sort === 'price-desc') ordered.sort((a, b) => Number(b.dataset.price) - Number(a.dataset.price));
      else if (s.sort === 'name') ordered.sort((a, b) => a.dataset.name.localeCompare(b.dataset.name));

      const visibleSet = new Set(shown);
      ordered.forEach((el) => {
        grid.insertBefore(el, empty);
        el.style.display = visibleSet.has(el) ? '' : 'none';
      });

      const n = shown.length;
      if (heading) heading.textContent = needle ? `Results for “${s.q}”` : 'Shop';
      if (countHead) countHead.textContent = `The collection · ${plural(n, 'piece', 'pieces')}`;
      if (countItems) countItems.textContent = plural(n, 'item', 'items');
      if (empty) empty.style.display = n === 0 ? '' : 'none';

      chips.forEach((c) => {
        const on = c.dataset.cat === s.cat;
        c.classList.toggle('is-active', on);
        if (on) c.setAttribute('aria-current', 'page');
        else c.removeAttribute('aria-current');
      });
      const allChip = document.querySelector('.as-subcats .as-chip[data-cat=""]');
      if (allChip) {
        const on = !s.cat;
        allChip.classList.toggle('is-active', on);
        if (on) allChip.setAttribute('aria-current', 'page');
        else allChip.removeAttribute('aria-current');
      }
      if (sortSel) sortSel.value = s.sort;
    }

    function go(mutate) {
      const u = new URL(window.location.href);
      mutate(u.searchParams);
      history.pushState({}, '', u.toString());
      apply();
    }

    document.querySelectorAll('.as-subcats .as-chip[data-cat]').forEach((a) => {
      a.addEventListener('click', (e) => {
        if (e.metaKey || e.ctrlKey || e.shiftKey || e.altKey || e.button !== 0) return;
        e.preventDefault();
        const cat = a.dataset.cat;
        go((sp) => {
          if (cat) sp.set('category', cat);
          else sp.delete('category');
        });
      });
    });

    sortSel?.addEventListener('change', (e) => {
      const value = e.target.value;
      go((sp) => {
        if (value) sp.set('sort', value);
        else sp.delete('sort');
      });
    });

    window.addEventListener('popstate', apply);
    apply();
  </script>
</StoreLayout>
