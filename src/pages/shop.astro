---
import Layout from '../components/Layout.astro';
import ProductCard from '../components/ProductCard.astro';
import { getProductsByCategory, getCategories, formatPKR } from '../lib/products.js';
import productsData from '../../data/products.json';

const visible = productsData.products.filter((p) => p.visible);
const categories = getCategories(productsData);

const url = new URL(Astro.request.url);
const selectedCategory = url.searchParams.get('category') || '';
const q = (url.searchParams.get('q') || '').toLowerCase().trim();

let filtered = visible;
if (selectedCategory) {
  filtered = getProductsByCategory(productsData, selectedCategory);
}
if (q) {
  filtered = filtered.filter((p) =>
    p.name.toLowerCase().includes(q) ||
    p.description.toLowerCase().includes(q) ||
    p.tags.some((t) => t.toLowerCase().includes(q))
  );
}

// Sort products server-side with link-safe query parameters
const sort = url.searchParams.get('sort') || '';
if (sort === 'price-asc') {
  filtered = [...filtered].sort((a, b) => a.price_pkr - b.price_pkr);
} else if (sort === 'price-desc') {
  filtered = [...filtered].sort((a, b) => b.price_pkr - a.price_pkr);
} else if (sort === 'name') {
  filtered = [...filtered].sort((a, b) => a.name.localeCompare(b.name));
}
---

<Layout title="Shop — AASRA" description="Browse the AASRA collection. Home textiles, rugs, tableware, woodware. PKR.">
  <div class="page-title-block">
    <div class="kicker">The collection</div>
    <h1>Shop</h1>
    {q && <p class="page-sub">Search results for “{q}”</p>}
  </div>

  <!-- Product category navigation -->
  <div class="container">
    <nav class="plp-catnav" aria-label="Product categories">
      <a href="/shop" class={!selectedCategory && !q ? 'active' : ''}>All</a>
      {categories.map((cat) => (
        <a href={`/shop?category=${cat}`} class={selectedCategory === cat ? 'active' : ''}>
          {cat.charAt(0).toUpperCase() + cat.slice(1).replace('-', ' ')}
        </a>
      ))}
      <a href="/gifts">Gifts</a>
    </nav>
  </div>

  <section class="section-tight">
    <div class="container">
      <div class="plp-toolbar">
        <span class="small-caps">{filtered.length} products</span>
        <label class="sort-label">
          <span class="small-caps">Sort by</span>
          <select class="sort-select" id="sort-select" aria-label="Sort products">
            <option value="" selected={!sort}>Our selection</option>
            <option value="price-asc" selected={sort === 'price-asc'}>Price: low to high</option>
            <option value="price-desc" selected={sort === 'price-desc'}>Price: high to low</option>
            <option value="name" selected={sort === 'name'}>Name A–Z</option>
          </select>
        </label>
      </div>

      <div class="shop-layout">
        <!-- Filters sidebar -->
        <aside class="shop-filters">
          <div class="small-caps" style="margin-bottom:0.75rem;">Categories</div>
          <ul>
            <li>
              <a href="/shop" class={selectedCategory === '' ? 'active' : ''}>All</a>
            </li>
            {categories.map((cat) => (
              <li>
                <a href={`/shop?category=${cat}`} class={selectedCategory === cat ? 'active' : ''}>
                  {cat.charAt(0).toUpperCase() + cat.slice(1).replace('-', ' ')}
                </a>
              </li>
            ))}
          </ul>
        </aside>

        <!-- Product grid -->
        <div class="grid" style="flex:1;">
          {filtered.length > 0 ? (
            filtered.map((p) => <ProductCard product={p} />)
          ) : (
            <p style="grid-column:1/-1; color:var(--muted);">No products found.</p>
          )}
        </div>
      </div>
    </div>
  </section>

  <script>
    // @ts-nocheck -- browser-only event handlers use DOM APIs guarded at runtime.
    document.getElementById('sort-select')?.addEventListener('change', (e) => {
      const u = new URL(window.location);
      if (e.target.value) u.searchParams.set('sort', e.target.value);
      else u.searchParams.delete('sort');
      window.location.href = u.toString();
    });
  </script>
</Layout>

<style>
  .font-bold { font-weight: 600; }
  .text-black { color: var(--text); }
</style>
