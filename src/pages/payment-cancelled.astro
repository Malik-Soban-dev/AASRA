---
import Layout from '../components/Layout.astro';
---

<Layout title="Payment cancelled — AASRA" description="Your payment was cancelled.">
  <!-- Announcement bar -->
  <div style="background:#fff; border-bottom:1px solid var(--border);">
    <div class="container" style="padding:0.4rem 1.5rem; font-size:0.75rem; text-transform:uppercase; letter-spacing:0.12em; color:var(--muted); text-align:center;">
      Free shipping on orders above 20,000 PKR · No Cash on Delivery · Pay in full or deposit + balance online
    </div>
  </div>

  <section class="section">
    <div class="container" style="max-width:560px;">
      <h1>Payment cancelled</h1>
      <p>Your payment was not completed. Your order remains pending and your cart is still saved.</p>
      <p>You can try again or pay the balance later using the link in your order confirmation email.</p>
      <div style="margin-top:2rem;">
        <a href="/order-lookup" class="btn btn-primary">Look up your order</a>
        <a href="/cart" class="btn">Back to cart</a>
      </div>
    </div>
  </section>
</Layout>
