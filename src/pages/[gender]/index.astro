---
/**
 * Gender landing — /women, /men. Same flow as the home page, so the two
 * gender pages stay consistent: full-screen campaign carousel → collection
 * tile pairs → New in rail → denim drop → Categories in Focus → delivery facts.
 */
import StoreLayout from '../../components/layout/StoreLayout.astro';
import ProductRail from '../../components/store/ProductRail.astro';
import RunwayHero from '../../components/store/RunwayHero.astro';
import CategoriesFocus from '../../components/store/CategoriesFocus.astro';
import CategoryStrip from '../../components/store/CategoryStrip.astro';
import FootwearFeature from '../../components/store/FootwearFeature.astro';
import { collectionsList } from '../../lib/collections.js';
import { newArrivals, categoryProducts, categories, categoryLabel } from '../../lib/catalog.js';

export function getStaticPaths() {
  return [{ params: { gender: 'women' } }, { params: { gender: 'men' } }];
}

const { gender } = Astro.params;
const title = gender === 'women' ? 'Women' : 'Men';
const kicker = gender === 'women' ? 'The handloom edit' : 'Quiet menswear';
const newIn = newArrivals(gender).slice(0, 4);
const denim = categoryProducts(gender, 'denim');
const tiles = collectionsList.filter((c) => c.kicker === title);
// Category strip: every collection for this gender (footwear included), one photo each.
const stripItems = (categories[gender] || []).filter((c) => c.category !== 'new-in').map((c) => {
  const first = categoryProducts(gender, c.category)[0];
  return { href: `/${gender}/${c.category}`, label: categoryLabel(gender, c.category), img: first?.images[0], alt: first?.name || categoryLabel(gender, c.category) };
});
const footwear = categoryProducts(gender, 'footwear');

const slides = [
  { img: `/images/look/hero-${gender}.jpg`, caption: `${kicker} — ${title}`, alt: `${title}, spring campaign` },
  { img: '/images/look/banner-runway.jpg', caption: 'The campaign — Spring / Summer', alt: 'Two models in handloom linen on a sunlit runway' },
  { img: '/images/look/denim-drop-banner.jpg', caption: 'New season — Denim', alt: 'Two models in indigo denim walking on a sunlit street' },
];
---

<StoreLayout title={`${title} — AASRA`}>
  <RunwayHero
    slides={slides}
    kicker={kicker}
    headline={title}
    ctas={[{ label: 'Shop new in', href: `/${gender}/new-in` }, { label: 'Shop denim', href: `/${gender}/denim` }]}
    label={`${title} collection`}
  />

  <CategoryStrip items={stripItems} />

  <section class="as-home-section container" aria-labelledby="tiles-title">
    <h2 class="as-h2 as-visually-hidden" id="tiles-title">Collections</h2>
    <ul class={`as-tiles as-tiles--${gender}`} role="list">
      {tiles.map((c) => (
        <li class="as-reveal">
          <a class="as-tile" href={c.href}>
            <span class="as-tile-pair">
              <img src={c.imgs[0]} alt={c.alt} loading="lazy" width="600" height="800" />
              <img src={c.imgs[1]} alt="" loading="lazy" width="600" height="800" />
            </span>
            <span class="as-tile-meta">
              <span class="as-tile-kicker">{c.kicker}</span>
              <span class="as-tile-title">{c.title}</span>
            </span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <ProductRail
    class="as-home-rail"
    kicker="Fresh off the loom"
    title={`New in ${title.toLowerCase()}`}
    products={newIn}
    link={{ label: 'View all', href: `/${gender}/new-in` }}
  />

  <div class="as-denim-drop">
    <div class="as-denim-banner">
      <img src="/images/look/denim-drop-banner.jpg" alt="Two models in indigo denim walking on a sunlit street" width="1600" height="900" loading="lazy" />
      <div class="as-denim-banner-copy">
        <p class="as-kicker">New season</p>
        <h2 class="as-denim-title" id="denim-drop-title">New Denim Drop</h2>
        <div class="as-denim-actions">
          <a class="as-btn as-btn--solid" href={`/${gender}/denim`}>{`Shop ${title.toLowerCase()} denim`}</a>
        </div>
      </div>
    </div>
    <ProductRail
      class="as-denim-rail"
      kicker="Denim"
      title="Shop the drop"
      products={denim}
      link={{ label: 'View all', href: `/${gender}/denim` }}
    />
  </div>

  <FootwearFeature
    gender={gender}
    img={`/images/look/footwear-${gender}.jpg`}
    lede="Leather, canvas and suede, made to walk in."
    href={`/${gender}/footwear`}
  />
  <ProductRail
    class="as-footwear-rail"
    kicker="Footwear"
    title="Shop the pairs"
    products={footwear}
    link={{ label: 'View all', href: `/${gender}/footwear` }}
  />

  <CategoriesFocus genders={[gender]} />

  <section class="as-home-facts container" aria-label="Delivery and returns">
    <ul role="list">
      <li><strong>Free delivery</strong><span>on orders over PKR 20,000</span></li>
      <li><strong>Dispatched in 2 days</strong><span>by TCS courier, 2–7 days by city</span></li>
      <li><strong>Returns within 7 days</strong><span>of delivery, unused and with tags</span></li>
    </ul>
  </section>
</StoreLayout>
