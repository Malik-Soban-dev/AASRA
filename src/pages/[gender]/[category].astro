---
/**
 * PLP — /women/dresses, /men/new-in, …
 * Breadcrumb → title → sub-category chips → toolbar with a filter panel (color/size,
 * client-side) and sort → product grid → empty state.
 */
import StoreLayout from '../../components/layout/StoreLayout.astro';
import ProductCard from '../../components/store/ProductCard.astro';
import { categories, categoryProducts, categoryLabel } from '../../lib/catalog.js';

export function getStaticPaths() {
  const paths = [];
  for (const gender of ['women', 'men']) {
    for (const cat of categories[gender]) {
      paths.push({ params: { gender, category: cat.category } });
    }
  }
  return paths;
}

const { gender, category } = Astro.params;
const label = categoryLabel(gender, category);
const items = categoryProducts(gender, category);
const subcats = categories[gender];
const isWomen = gender === 'women';

const allColors = [...new Map(items.flatMap((p) => p.colors).map((c) => [c.name, c])).values()];
const allSizes = [...new Set(items.flatMap((p) => p.sizes))];
---

<StoreLayout title={`${label} — ${isWomen ? 'Women' : 'Men'} — AASRA`}>
  <div class="container">
    <nav class="as-breadcrumb" aria-label="Breadcrumb">
      <a href="/">Home</a><span>/</span>
      <a href={`/${gender}`}>{isWomen ? 'Women' : 'Men'}</a><span>/</span>
      <span aria-current="page">{label}</span>
    </nav>

    <header class="as-plp-head">
      <p class="as-kicker">{isWomen ? 'Women' : 'Men'} · {items.length} {items.length === 1 ? 'piece' : 'pieces'}</p>
      <h1 class="as-display-l">{label}</h1>
      <p class="as-muted" style="max-width:52ch">
        {category === 'new-in'
          ? 'The latest pieces off the loom and out of the dye vats.'
          : 'Natural fibres, small runs, made close to home.'}
      </p>
    </header>

    <div class="as-subcats" role="navigation" aria-label="Sub-categories">
      {subcats.map((c) => (
        <a class:list={['as-chip', { 'is-active': c.category === category }]} href={c.href}>{c.label}</a>
      ))}
    </div>

    <div class="as-plp-body" data-plp-bar>
      <div class="as-plp-toolbar">
        <button type="button" class="as-filter-toggle" aria-expanded="false" aria-controls="as-filter-panel" data-filter-toggle>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h9M17 7h3M4 17h3M11 17h9" /><circle cx="15" cy="7" r="2" /><circle cx="9" cy="17" r="2" /></svg>
          <span>Filter</span>
          <span class="as-filter-count" data-filter-count hidden>0</span>
        </button>
        <p class="as-plp-count" id="as-count" aria-live="polite">{items.length} {items.length === 1 ? 'item' : 'items'}</p>
        <div class="as-sort-wrap">
          <label class="as-filter-legend" for="as-sort">Sort</label>
          <select class="as-sort" id="as-sort">
            <option value="featured">Featured</option>
            <option value="price-asc">Price: low to high</option>
            <option value="price-desc">Price: high to low</option>
            <option value="name">Name</option>
          </select>
        </div>
      </div>

      <div class="as-filter-panel" id="as-filter-panel" data-filter-panel hidden>
        <div class="as-facet">
          <p class="as-facet-legend">Colour</p>
          <div class="as-facet-opts">
            {allColors.map((c) => (
              <button type="button" class="as-opt as-opt--colour" aria-pressed="false" data-filter-color={c.name}>
                <i style={`background:${c.hex}`} aria-hidden="true"></i>{c.name}
              </button>
            ))}
          </div>
        </div>
        <div class="as-facet">
          <p class="as-facet-legend">Size</p>
          <div class="as-facet-opts">
            {allSizes.map((s) => (
              <button type="button" class="as-opt as-opt--size" aria-pressed="false" data-filter-size={s}>{s}</button>
            ))}
          </div>
        </div>
        <div class="as-facet-foot">
          <button type="button" class="as-filter-clear" data-filter-clear disabled>Clear all</button>
          <button type="button" class="as-btn as-btn--solid as-filter-done" data-filter-done>Done</button>
        </div>
      </div>

      <div class="as-plp-empty" id="as-nomatch" hidden>
        <p>Nothing matches these filters.</p>
        <button type="button" class="as-btn as-btn--outline" data-filter-clear-inline>Clear filters</button>
      </div>

    <div class="as-grid" id="as-grid" data-stagger>
      {items.map((p, i) => (
        <div class="as-reveal as-grid-item" style={`--i:${i}`}
          data-colors={p.colors.map((c) => c.name).join(',')}
          data-sizes={p.sizes.join(',')}
          data-price={p.price_pkr}
          data-name={p.name}>
          <ProductCard product={p} />
        </div>
      ))}
      {items.length === 0 && (
        <div class="as-empty">
          <h2 class="as-h2">The next drop is on the loom</h2>
          <p class="as-muted">This category is being woven. Meanwhile, see what just landed.</p>
          <p style="margin-top:var(--as-s5)"><a class="as-btn as-btn--outline" href={`/${gender}/new-in`}>New in</a></p>
        </div>
      )}
    </div>
    </div>
  </div>

  <script>
    // Client-side filter + sort (no reload). Filter panel toggles open/closed; the count and Clear all track the selection.
    const grid = document.getElementById('as-grid');
    const items = [...grid.querySelectorAll('.as-grid-item')];
    const countEl = document.getElementById('as-count');
    const toggle = document.querySelector('[data-filter-toggle]');
    const panel = document.getElementById('as-filter-panel');
    const badge = document.querySelector('[data-filter-count]');
    const clearBtn = document.querySelector('[data-filter-clear]');
    const noMatch = document.getElementById('as-nomatch');
    const active = { color: null, size: null };

    const setOpen = (open) => {
      panel.hidden = !open;
      toggle.setAttribute('aria-expanded', String(open));
    };
    toggle.addEventListener('click', () => setOpen(panel.hidden));
    document.querySelector('[data-filter-done]')?.addEventListener('click', () => { setOpen(false); toggle.focus(); });

    const syncPressed = () => {
      document.querySelectorAll('[data-filter-color]').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.filterColor === active.color)));
      document.querySelectorAll('[data-filter-size]').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.filterSize === active.size)));
    };

    const apply = () => {
      let visible = 0;
      items.forEach((el) => {
        const colors = el.dataset.colors.split(',');
        const sizes = el.dataset.sizes.split(',');
        const ok = (!active.color || colors.includes(active.color)) && (!active.size || sizes.includes(active.size));
        el.style.display = ok ? '' : 'none';
        if (ok) visible++;
      });
      countEl.textContent = `${visible} item${visible === 1 ? '' : 's'}`;
      const n = (active.color ? 1 : 0) + (active.size ? 1 : 0);
      badge.textContent = String(n);
      badge.hidden = n === 0;
      toggle.classList.toggle('has-filters', n > 0);
      clearBtn.disabled = n === 0;
      noMatch.hidden = visible > 0;
      syncPressed();
    };

    const clearAll = () => { active.color = null; active.size = null; apply(); };
    clearBtn.addEventListener('click', clearAll);
    document.querySelector('[data-filter-clear-inline]')?.addEventListener('click', clearAll);

    document.querySelectorAll('[data-filter-color]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const value = btn.dataset.filterColor;
        active.color = active.color === value ? null : value;
        apply();
      });
    });
    document.querySelectorAll('[data-filter-size]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const value = btn.dataset.filterSize;
        active.size = active.size === value ? null : value;
        apply();
      });
    });
    document.getElementById('as-sort')?.addEventListener('change', (e) => {
      const mode = e.target.value;
      const sorted = [...items].sort((a, b) => {
        if (mode === 'price-asc') return a.dataset.price - b.dataset.price;
        if (mode === 'price-desc') return b.dataset.price - a.dataset.price;
        if (mode === 'name') return a.dataset.name.localeCompare(b.dataset.name);
        return items.indexOf(a) - items.indexOf(b);
      });
      sorted.forEach((el) => grid.appendChild(el));
    });
  </script>
</StoreLayout>
