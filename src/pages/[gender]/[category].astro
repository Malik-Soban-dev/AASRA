---
/**
 * PLP — /women/dresses, /men/new-in, …
 * Breadcrumb → title → sub-category chips → sticky filter bar (color/size/sort,
 * client-side) → product grid → empty state.
 */
import StoreLayout from '../../components/layout/StoreLayout.astro';
import ProductCard from '../../components/store/ProductCard.astro';
import { categories, categoryProducts, categoryLabel } from '../../lib/catalog.js';

export function getStaticPaths() {
  const paths = [];
  for (const gender of ['women', 'men']) {
    for (const cat of categories[gender]) {
      paths.push({ params: { gender, category: cat.category } });
    }
  }
  return paths;
}

const { gender, category } = Astro.params;
const label = categoryLabel(gender, category);
const items = categoryProducts(gender, category);
const subcats = categories[gender];
const isWomen = gender === 'women';

const allColors = [...new Map(items.flatMap((p) => p.colors).map((c) => [c.name, c])).values()];
const allSizes = [...new Set(items.flatMap((p) => p.sizes))];
---

<StoreLayout title={`${label} — ${isWomen ? 'Women' : 'Men'} — AASRA`}>
  <div class="container">
    <nav class="as-breadcrumb" aria-label="Breadcrumb">
      <a href="/">Home</a><span>/</span>
      <a href={`/${gender}`}>{isWomen ? 'Women' : 'Men'}</a><span>/</span>
      <span aria-current="page">{label}</span>
    </nav>

    <header class="as-plp-head">
      <p class="as-kicker">{isWomen ? 'Women' : 'Men'} · {items.length} {items.length === 1 ? 'piece' : 'pieces'}</p>
      <h1 class="as-display-l">{label}</h1>
      <p class="as-muted" style="max-width:52ch">
        {category === 'new-in'
          ? 'The latest pieces off the loom and out of the dye vats.'
          : 'Natural fibres, small runs, made close to home.'}
      </p>
    </header>

    <div class="as-subcats" role="navigation" aria-label="Sub-categories">
      {subcats.map((c) => (
        <a class:list={['as-chip', { 'is-active': c.category === category }]} href={c.href}>{c.label}</a>
      ))}
    </div>

    <div class="as-filterbar" data-filterbar>
      <div class="as-filter-group">
        <span class="as-filter-legend">Colour</span>
        {allColors.map((c) => (
          <button type="button" class="as-chip" data-filter-color={c.name} title={c.name}>
            <i style={`background:${c.hex};width:11px;height:11px;border-radius:50%;margin-right:6px;display:inline-block`}></i>{c.name}
          </button>
        ))}
      </div>
      <div class="as-filter-group">
        <span class="as-filter-legend">Size</span>
        {allSizes.map((s) => (
          <button type="button" class="as-chip" data-filter-size={s}>{s}</button>
        ))}
      </div>
      <div class="as-filter-group">
        <label class="as-filter-legend" for="as-sort">Sort</label>
        <select class="as-sort" id="as-sort">
          <option value="featured">Featured</option>
          <option value="price-asc">Price: low to high</option>
          <option value="price-desc">Price: high to low</option>
          <option value="name">Name</option>
        </select>
      </div>
    </div>

    <p class="as-kicker" id="as-count" style="margin:var(--as-s4) 0">{items.length} items</p>

    <div class="as-grid" id="as-grid" data-stagger>
      {items.map((p, i) => (
        <div class="as-reveal as-grid-item" style={`--i:${i}`}
          data-colors={p.colors.map((c) => c.name).join(',')}
          data-sizes={p.sizes.join(',')}
          data-price={p.price_pkr}
          data-name={p.name}>
          <ProductCard product={p} />
        </div>
      ))}
      {items.length === 0 && (
        <div class="as-empty">
          <h2 class="as-h2">The next drop is on the loom</h2>
          <p class="as-muted">This category is being woven. Meanwhile, see what just landed.</p>
          <p style="margin-top:var(--as-s5)"><a class="as-btn as-btn--outline" href={`/${gender}/new-in`}>New in</a></p>
        </div>
      )}
    </div>
  </div>

  <script>
    // Client-side filter + sort (no reload) — design system PLP rules.
    const grid = document.getElementById('as-grid');
    const items = [...grid.querySelectorAll('.as-grid-item')];
    const countEl = document.getElementById('as-count');
    const active = { color: null, size: null };

    const apply = () => {
      let visible = 0;
      items.forEach((el) => {
        const colors = el.dataset.colors.split(',');
        const sizes = el.dataset.sizes.split(',');
        const ok = (!active.color || colors.includes(active.color)) && (!active.size || sizes.includes(active.size));
        el.style.display = ok ? '' : 'none';
        if (ok) visible++;
      });
      countEl.textContent = `${visible} item${visible === 1 ? '' : 's'}`;
    };

    document.querySelectorAll('[data-filter-color]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const value = btn.dataset.filterColor;
        active.color = active.color === value ? null : value;
        document.querySelectorAll('[data-filter-color]').forEach((b) => b.classList.toggle('is-active', b.dataset.filterColor === active.color));
        apply();
      });
    });
    document.querySelectorAll('[data-filter-size]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const value = btn.dataset.filterSize;
        active.size = active.size === value ? null : value;
        document.querySelectorAll('[data-filter-size]').forEach((b) => b.classList.toggle('is-active', b.dataset.filterSize === active.size));
        apply();
      });
    });
    document.getElementById('as-sort')?.addEventListener('change', (e) => {
      const mode = e.target.value;
      const sorted = [...items].sort((a, b) => {
        if (mode === 'price-asc') return a.dataset.price - b.dataset.price;
        if (mode === 'price-desc') return b.dataset.price - a.dataset.price;
        if (mode === 'name') return a.dataset.name.localeCompare(b.dataset.name);
        return items.indexOf(a) - items.indexOf(b);
      });
      sorted.forEach((el) => grid.appendChild(el));
    });
  </script>
</StoreLayout>
