---
/**
 * Home — follows the reference's page flow:
 * banner → collection tile pairs (image pair + title) → labelled category
 * grid per gender → New In rail → delivery facts. Our photos and copy only.
 * Styles: .as-home-*, .as-tiles, .as-labels (store.css).
 */
import StoreLayout from '../components/layout/StoreLayout.astro';
import ProductRail from '../components/store/ProductRail.astro';
import { newArrivals, categoryProducts, categories, categoryLabel, formatPrice } from '../lib/catalog.js';
const denimProducts = [...categoryProducts('women', 'denim'), ...categoryProducts('men', 'denim')];
import site from '../../data/catalog/site.json';

const newIn = newArrivals().slice(0, 4);

// Collection tiles: two photos per tile, title below (reference: "Artisanal Collection" style).
const collections = [
  { title: 'Dresses & Kurtas', kicker: 'Women', href: '/women/dresses', imgs: ['/images/garments/w-dress-clay.jpg', '/images/garments/w-kurta-ivory.jpg'], alt: 'Clay wrap dress and ivory kurta' },
  { title: 'Outerwear & Shawls', kicker: 'Women', href: '/women/outerwear', imgs: ['/images/garments/w-coat-sand.jpg', '/images/garments/w-cardigan-olive.jpg'], alt: 'Sand coat and olive cardigan' },
  { title: 'Shirts & Kurtas', kicker: 'Men', href: '/men/shirts', imgs: ['/images/garments/m-shirt-slate.jpg', '/images/garments/m-kurta-indigo.jpg'], alt: 'Slate shirt and indigo kurta' },
  { title: 'Knitwear', kicker: 'Men', href: '/men/knitwear', imgs: ['/images/garments/m-crew-charcoal.jpg', '/images/garments/m-shirt-slate.jpg'], alt: 'Charcoal knit and slate shirt' },
];

// Categories in Focus: each category with its products (a row of cards on the right).
const focusGroups = ['women', 'men'].flatMap((gender) =>
  (categories[gender] || []).filter((c) => c.category !== 'new-in').map((c) => ({
    key: `${gender}-${c.category}`,
    gender,
    label: categoryLabel(gender, c.category),
    products: categoryProducts(gender, c.category).slice(0, 10),
  }))
).map((g, _, all) => ({
  ...g,
  label: all.filter((o) => o.label === g.label).length > 1 ? `${g.label} (${g.gender === 'women' ? 'Women' : 'Men'})` : g.label,
}));
---

<StoreLayout>
  <section class="as-home-hero" aria-labelledby="home-title">
    <div class="as-home-hero-media">
      <img src="/images/look/banner-runway.jpg" alt="Two models in handloom linen on a sunlit runway" width="2000" height="1125" fetchpriority="high" />
    </div>
    <div class="as-home-hero-copy">
      <p class="as-kicker">{site.hero.kicker}</p>
      <h1 class="as-home-title" id="home-title">Wear the slow made</h1>
      <p class="as-home-lede">Handloom linen, natural dyes and small runs, made close to home in Pakistan.</p>
      <div class="as-home-actions">
        <a class="as-btn as-btn--solid" href={site.hero.women.href}>{site.hero.women.label}</a>
        <a class="as-btn as-btn--outline as-home-men" href={site.hero.men.href}>{site.hero.men.label}</a>
      </div>
    </div>
  </section>

  <section class="as-home-section container" aria-labelledby="tiles-title">
    <h2 class="as-h2 as-visually-hidden" id="tiles-title">Collections</h2>
    {['Women', 'Men'].map((g) => (
      <ul class={`as-tiles as-tiles--${g.toLowerCase()}`} role="list">
        {collections.filter((c) => c.kicker === g).map((c) => (
          <li class="as-reveal">
            <a class="as-tile" href={c.href}>
              <span class="as-tile-pair">
                <img src={c.imgs[0]} alt={c.alt} loading="lazy" width="600" height="800" />
                <img src={c.imgs[1]} alt="" loading="lazy" width="600" height="800" />
              </span>
              <span class="as-tile-meta">
                <span class="as-tile-kicker">{c.kicker}</span>
                <span class="as-tile-title">{c.title}</span>
              </span>
            </a>
          </li>
        ))}
      </ul>
    ))}
  </section>

  <div class="as-denim-drop">
    <div class="as-denim-banner">
      <img src="/images/look/denim-drop-banner.jpg" alt="Two models in indigo denim walking on a sunlit street" width="1600" height="900" loading="lazy" />
      <div class="as-denim-banner-copy">
        <p class="as-kicker">New season</p>
        <h2 class="as-denim-title" id="denim-drop-title">New Denim Drop</h2>
        <div class="as-denim-actions">
          <a class="as-btn as-btn--solid" href="/women/denim">Women's denim</a>
          <a class="as-btn as-btn--outline" href="/men/denim">Men's denim</a>
        </div>
      </div>
    </div>
    <ProductRail
      class="as-denim-rail"
      kicker="Denim"
      title="Shop the drop"
      products={denimProducts}
      link={{ label: 'View all', href: '/shop' }}
    />
  </div>

  <section class="as-focus" aria-labelledby="focus-title">
    <div class="as-focus-feature">
      {focusGroups.map((g, i) => (
        <img data-focus-feature={g.key} src={g.products[0].images[0]} alt="" loading="lazy" width="800" height="1000" hidden={i !== 0} />
      ))}
    </div>
    <div class="as-focus-main">
      <h2 class="as-focus-title" id="focus-title">Categories in Focus</h2>
      <div class="as-focus-nav">
        <button type="button" class="as-rail-btn" data-focus-prev aria-label="Previous products">
          <svg viewBox="0 0 24 24"><path d="M15 5l-7 7 7 7" /></svg>
        </button>
        <button type="button" class="as-rail-btn" data-focus-next aria-label="Next products">
          <svg viewBox="0 0 24 24"><path d="M9 5l7 7-7 7" /></svg>
        </button>
      </div>
      <nav class="as-focus-list" aria-label="Categories">
        <ul role="list">
          {focusGroups.map((g, i) => (
            <li>
              <button type="button" class:list={['as-focus-link', { 'is-active': i === 0 }]} data-focus={g.key} aria-pressed={i === 0 ? 'true' : 'false'}>{g.label}</button>
            </li>
          ))}
        </ul>
      </nav>
      <div class="as-focus-panels">
        {focusGroups.map((g, i) => (
          <div class="as-focus-panel" data-focus-panel={g.key} hidden={i !== 0}>
            <div class="as-focus-track">
              {g.products.map((p) => (
                <a class="as-focus-card" href={`/product/${p.slug}`}>
                  <span class="as-focus-img"><img src={p.images[0]} alt={p.name} loading="lazy" width="600" height="800" /></span>
                  <span class="as-focus-name">{p.name}</span>
                  <span class="as-focus-meta">{g.gender === 'women' ? 'Women' : 'Men'} · {g.label}</span>
                  <span class="as-focus-price">{formatPrice(p.price_pkr)}</span>
                  <span class="as-focus-swatches" aria-label={`${p.colors.length} colours`}>
                    {p.colors.map((c, i) => <i style={`background:${c.hex}`} title={c.name} data-colour-image={c.image || p.images[0]} data-colour={c.name} role="button" tabindex="0" aria-label={`Show ${c.name}`} aria-pressed={i === 0 ? 'true' : 'false'} class:list={['as-dot', { 'is-active': i === 0 }]}></i>)}
                  </span>
                </a>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <script>
    // Fade the right edge of the category names only while there are more names to scroll to.
    const focusList = document.querySelector('.as-focus-list ul');
    const markOverflow = () => focusList?.classList.toggle('is-overflow', focusList.scrollWidth - focusList.clientWidth > 4 && focusList.scrollLeft < focusList.scrollWidth - focusList.clientWidth - 4);
    if (focusList) { markOverflow(); focusList.addEventListener('scroll', markOverflow, { passive: true }); window.addEventListener('resize', markOverflow); }
    document.querySelectorAll('[data-focus]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const key = btn.dataset.focus;
        document.querySelectorAll('[data-focus]').forEach((b) => {
          const on = b === btn;
          b.classList.toggle('is-active', on);
          b.setAttribute('aria-pressed', on ? 'true' : 'false');
        });
        document.querySelectorAll('[data-focus-panel]').forEach((panel) => {
          panel.hidden = panel.dataset.focusPanel !== key;
        });
        document.querySelectorAll('[data-focus-feature]').forEach((img) => {
          img.hidden = img.dataset.focusFeature !== key;
        });
      });
    });
    // Previous / next arrows move the visible row by one card.
    const visibleTrack = () => document.querySelector('.as-focus-panel:not([hidden]) .as-focus-track');
    const step = (t) => (t.querySelector('.as-focus-card')?.getBoundingClientRect().width || 280) + 14;
    document.querySelector('[data-focus-prev]')?.addEventListener('click', () => { const t = visibleTrack(); t?.scrollBy({ left: -step(t), behavior: 'smooth' }); });
    document.querySelector('[data-focus-next]')?.addEventListener('click', () => { const t = visibleTrack(); t?.scrollBy({ left: step(t), behavior: 'smooth' }); });
  </script>

  <ProductRail
    class="as-home-rail"
    kicker="Fresh off the loom"
    title="New in"
    products={newIn}
    link={{ label: 'View all', href: '/women/new-in' }}
  />

  <section class="as-home-facts container" aria-label="Delivery and returns">
    <ul role="list">
      <li><strong>Free delivery</strong><span>on orders over PKR 20,000</span></li>
      <li><strong>Dispatched in 2 days</strong><span>by TCS courier, 2–7 days by city</span></li>
      <li><strong>Returns within 7 days</strong><span>of delivery, unused and with tags</span></li>
    </ul>
  </section>
</StoreLayout>
