---
/**
 * Home — one hero, the category row, New In, one campaign band, and the
 * delivery and returns facts. Shorter than before: fewer blocks, no text
 * over the photo on phones, identical tile proportions. Styles: .as-home-*.
 */
import StoreLayout from '../components/layout/StoreLayout.astro';
import ProductRail from '../components/store/ProductRail.astro';
import { newArrivals } from '../lib/catalog.js';
import site from '../../data/catalog/site.json';

const newIn = newArrivals().slice(0, 4);

const categories = [
  { img: '/images/garments/w-dress-clay.jpg', title: 'Dresses & Kurtas', href: '/women/dresses', alt: 'Clay linen wrap dress' },
  { img: '/images/garments/m-shirt-slate.jpg', title: 'Shirts & Kurtas', href: '/men/shirts', alt: 'Slate linen shirt' },
  { img: '/images/garments/w-cardigan-olive.jpg', title: 'Knitwear', href: '/women/knitwear', alt: 'Olive wool cardigan' },
  { img: '/images/garments/w-coat-sand.jpg', title: 'Outerwear & Shawls', href: '/women/outerwear', alt: 'Sand quilted shawl coat' },
];
---

<StoreLayout snap>
  <section class="as-home-hero" aria-labelledby="home-title">
    <div class="as-home-hero-media">
      <img src="/images/look/banner-runway.jpg" alt="Two models in handloom linen on a sunlit runway" width="2000" height="1125" fetchpriority="high" />
    </div>
    <div class="as-home-hero-copy">
      <p class="as-kicker">{site.hero.kicker}</p>
      <h1 class="as-home-title" id="home-title">Wear the slow made</h1>
      <p class="as-home-lede">Handloom linen, natural dyes and small runs, made close to home in Pakistan.</p>
      <div class="as-home-actions">
        <a class="as-btn as-btn--solid" href={site.hero.women.href}>{site.hero.women.label}</a>
        <a class="as-btn as-btn--outline as-home-men" href={site.hero.men.href}>{site.hero.men.label}</a>
      </div>
    </div>
  </section>

  <section class="as-home-section container" aria-labelledby="cats-title">
    <div class="as-home-head">
      <div>
        <p class="as-kicker">Shop by category</p>
        <h2 class="as-h2" id="cats-title">Made for the season, not the cycle</h2>
      </div>
      <a class="as-link" href="/shop">Shop all</a>
    </div>
    <ul class="as-cats" role="list">
      {categories.map((c) => (
        <li class="as-reveal">
          <a class="as-cat" href={c.href}>
            <span class="as-cat-img"><img src={c.img} alt={c.alt} loading="lazy" width="900" height="1125" /></span>
            <span class="as-cat-row">
              <span class="as-cat-title">{c.title}</span>
              <span class="as-cat-go" aria-hidden="true">→</span>
            </span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <ProductRail
    class="as-home-rail"
    kicker="Fresh off the loom"
    title="New in"
    products={newIn}
    link={{ label: 'View all', href: '/women/new-in' }}
  />

  <section class="as-home-campaign" aria-label="The campaign">
    <img src="/images/look/hero-women.jpg" alt="The ivory kurta styled with the olive cardigan" loading="lazy" width="1100" height="1375" />
    <div class="as-home-campaign-copy as-reveal">
      <p class="as-kicker">Spring / Summer</p>
      <h2 class="as-display-l">Made slowly.<br />Worn often.</h2>
      <a class="as-btn as-btn--light" href="/women/new-in">Discover the collection</a>
    </div>
  </section>

  <section class="as-home-facts container" aria-label="Delivery and returns">
    <ul role="list">
      <li><strong>Free delivery</strong><span>on orders over PKR 20,000</span></li>
      <li><strong>Dispatched in 2 days</strong><span>by TCS courier, 2–7 days by city</span></li>
      <li><strong>Returns within 7 days</strong><span>of delivery, unused and with tags</span></li>
    </ul>
  </section>
</StoreLayout>
