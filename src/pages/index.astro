---
/**
 * Home — follows the reference's page flow:
 * banner → collection tile pairs (image pair + title) → labelled category
 * grid per gender → New In rail → delivery facts. Our photos and copy only.
 * Styles: .as-home-*, .as-tiles, .as-labels (store.css).
 */
import StoreLayout from '../components/layout/StoreLayout.astro';
import ProductRail from '../components/store/ProductRail.astro';
import CategoriesFocus from '../components/store/CategoriesFocus.astro';
import { collectionsList } from '../lib/collections.js';
import { newArrivals, categoryProducts, categories, categoryLabel, formatPrice } from '../lib/catalog.js';
const denimProducts = [...categoryProducts('women', 'denim'), ...categoryProducts('men', 'denim')];
import site from '../../data/catalog/site.json';

const newIn = newArrivals().slice(0, 4);

// Collection tiles live in src/lib/collections.js (shared with the gender pages).
const collections = collectionsList;

---

<StoreLayout spa>
  <section class="as-home-hero" aria-labelledby="home-title">
    <div class="as-home-hero-media">
      <img src="/images/look/banner-runway.jpg" alt="Two models in handloom linen on a sunlit runway" width="2000" height="1125" fetchpriority="high" />
    </div>
    <div class="as-home-hero-copy">
      <p class="as-kicker">{site.hero.kicker}</p>
      <h1 class="as-home-title" id="home-title">Wear the slow made</h1>
      <p class="as-home-lede">Handloom linen, natural dyes and small runs, made close to home in Pakistan.</p>
      <div class="as-home-actions">
        <a class="as-btn as-btn--solid" href={site.hero.women.href}>{site.hero.women.label}</a>
        <a class="as-btn as-btn--outline as-home-men" href={site.hero.men.href}>{site.hero.men.label}</a>
      </div>
    </div>
  </section>

  <section class="as-home-section container" aria-labelledby="tiles-title">
    <h2 class="as-h2 as-visually-hidden" id="tiles-title">Collections</h2>
    {['Women', 'Men'].map((g) => (
      <ul class={`as-tiles as-tiles--${g.toLowerCase()}`} role="list">
        {collections.filter((c) => c.kicker === g).map((c) => (
          <li class="as-reveal">
            <a class="as-tile" href={c.href}>
              <span class="as-tile-pair">
                <img src={c.imgs[0]} alt={c.alt} loading="lazy" width="600" height="800" />
                <img src={c.imgs[1]} alt="" loading="lazy" width="600" height="800" />
              </span>
              <span class="as-tile-meta">
                <span class="as-tile-kicker">{c.kicker}</span>
                <span class="as-tile-title">{c.title}</span>
              </span>
            </a>
          </li>
        ))}
      </ul>
    ))}
  </section>

  <ProductRail
    class="as-home-rail"
    kicker="Fresh off the loom"
    title="New in"
    products={newIn}
    link={{ label: 'View all', href: '/women/new-in' }}
  />

  <div class="as-denim-drop">
    <div class="as-denim-banner">
      <img src="/images/look/denim-drop-banner.jpg" alt="Two models in indigo denim walking on a sunlit street" width="1600" height="900" loading="lazy" />
      <div class="as-denim-banner-copy">
        <p class="as-kicker">New season</p>
        <h2 class="as-denim-title" id="denim-drop-title">New Denim Drop</h2>
        <div class="as-denim-actions">
          <a class="as-btn as-btn--solid" href="/women/denim">Women's denim</a>
          <a class="as-btn as-btn--outline" href="/men/denim">Men's denim</a>
        </div>
      </div>
    </div>
    <ProductRail
      class="as-denim-rail"
      kicker="Denim"
      title="Shop the drop"
      products={denimProducts}
      link={{ label: 'View all', href: '/shop' }}
    />
  </div>

  <CategoriesFocus />

  <section class="as-home-facts container" aria-label="Delivery and returns">
    <ul role="list">
      <li><strong>Free delivery</strong><span>on orders over PKR 20,000</span></li>
      <li><strong>Dispatched in 2 days</strong><span>by TCS courier, 2–7 days by city</span></li>
      <li><strong>Returns within 7 days</strong><span>of delivery, unused and with tags</span></li>
    </ul>
  </section>
</StoreLayout>
