---
/**
 * Home — runway hero, marquee, the edit (broken editorial grid), new-in rail,
 * campaign banner, shop the look. Composition only; see docs/DESIGN_SYSTEM.md.
 */
import StoreLayout from '../components/layout/StoreLayout.astro';
import RunwayHero from '../components/store/RunwayHero.astro';
import ProductRail from '../components/store/ProductRail.astro';
import { newArrivals, products, formatPrice } from '../lib/catalog.js';

const newIn = newArrivals().slice(0, 6);
const lookItems = ['W001', 'W003'].map((id) => products.find((p) => p.id === id)).filter(Boolean);

const tiles = [
  { img: '/images/garments/w-dress-clay.jpg', kicker: 'The spring edit', title: 'Dresses & Kurtas', href: '/women/dresses', alt: 'Clay linen wrap dress' },
  { img: '/images/garments/m-shirt-slate.jpg', kicker: 'New in', title: 'Shirts & Kurtas', href: '/men/shirts', alt: 'Slate linen shirt' },
  { img: '/images/garments/w-cardigan-olive.jpg', kicker: 'Handloom', title: 'Knitwear', href: '/women/knitwear', alt: 'Olive wool cardigan' },
  { img: '/images/garments/w-coat-sand.jpg', kicker: 'Limited', title: 'Outerwear & Shawls', href: '/women/outerwear', alt: 'Sand quilted shawl coat' },
];
---

<StoreLayout snap>
  <RunwayHero />

  <section class="as-section container as-snap-section" aria-labelledby="edit-title">
    <div class="as-section-head as-reveal">
      <div>
        <p class="as-kicker">The edit</p>
        <h2 class="as-h2" id="edit-title">Made for the season, not the cycle</h2>
      </div>
      <a class="as-link" href="/women">Shop all</a>
    </div>
    <div class="as-edit-row" data-stagger>
      {tiles.map((t, i) => (
        <a class:list={['as-edit-tile', 'as-reveal']} style={`--i:${i}`} href={t.href}>
          <img src={t.img} alt={t.alt} loading="lazy" width="900" height="1125" />
          <div class="as-edit-label">
            <p class="as-kicker">{t.kicker}</p>
            <h3>{t.title}</h3>
            <span class="as-link as-link--light">Shop</span>
          </div>
        </a>
      ))}
    </div>
  </section>

  <ProductRail
    class="as-snap-section"
    kicker="Fresh off the loom"
    title="New in"
    products={newIn}
    link={{ label: 'View all', href: '/women/new-in' }}
  />

  <section class="as-campaign as-snap-section" aria-label="The campaign">
    <img src="/images/look/banner-runway.jpg" alt="Two models walking through a sunlit atelier" loading="lazy" width="2000" height="1125" />
    <div class="as-campaign-copy as-reveal">
      <p class="as-kicker">Spring / Summer campaign</p>
      <h2 class="as-display-l">Made slowly.<br />Worn often.</h2>
      <a class="as-link as-link--light" href="/women/new-in">Discover the collection</a>
    </div>
  </section>

  <section class="as-section container as-snap-section" aria-labelledby="look-title">
    <div class="as-section-head as-reveal">
      <div>
        <p class="as-kicker">Styled</p>
        <h2 class="as-h2" id="look-title">Shop the look</h2>
      </div>
    </div>
    <div class="as-look as-reveal">
      <div class="as-look-media">
        <img src="/images/look/hero-women.jpg" alt="The ivory kurta styled with the olive cardigan" loading="lazy" width="1100" height="1375" />
      </div>
      <div>
        <p class="as-kicker">Wear it together</p>
        <h3 class="as-h2" style="margin:.5rem 0 1.5rem">Quiet layers, natural fibres</h3>
        {lookItems.map((item) => (
          <div class="as-look-item">
            <img src={item.images[0]} alt={item.name} loading="lazy" width="96" height="128" />
            <div>
              <h4><a href={`/product/${item.slug}`}>{item.name}</a></h4>
              <p class="as-price as-muted">{formatPrice(item.price_pkr)}</p>
            </div>
            <a class="as-btn as-btn--outline" href={`/product/${item.slug}`}>View</a>
          </div>
        ))}
        <a class="as-link" href="/women" style="margin-top:1.5rem">Explore the edit</a>
      </div>
    </div>
  </section>
</StoreLayout>
