---
import Layout from '../components/Layout.astro';
import ProductCard from '../components/ProductCard.astro';
import productsData from '../../data/products.json';

const featuredProducts = productsData.products.filter((product) => product.visible).slice(0, 4);
const collections = [
  { title: 'Textiles', note: 'Linen, cotton & quiet layers', href: '/shop?category=home-textiles', image: '/images/products/linen-curtain-ivory-1.webp', alt: 'Natural ivory linen curtain catching the light' },
  { title: 'Dhurries', note: 'Woven slowly, made to live with', href: '/shop?category=rugs', image: '/images/products/dhurrie-beige-1.webp', alt: 'Handwoven beige cotton dhurrie' },
  { title: 'Table pieces', note: 'For the everyday gathering', href: '/shop?category=tableware', image: '/images/products/dinner-plate-1.webp', alt: 'Hand-finished ceramic dinner plates' },
  { title: 'Wood objects', note: 'The warmth of solid teak', href: '/shop?category=woodware', image: '/images/products/teak-tray-1.webp', alt: 'Handmade teak serving tray' },
];
const journal = [
  { title: 'The feel of linen', category: 'Material notes', href: '/journal/caring-for-linen', image: '/images/products/linen-curtain-ivory-2.webp', alt: 'Soft folds of natural linen' },
  { title: 'A rug with a story', category: 'From the loom', href: '/journal/the-dhurrie', image: '/images/products/dhurrie-charcoal-1.webp', alt: 'A close view of a woven dhurrie' },
  { title: 'A table, together', category: 'At home', href: '/journal/the-winter-table', image: '/images/campaign/gifts-table.webp', alt: 'A table set for an intimate meal' },
];
---

<Layout title="AASRA — objects for living well" description="Thoughtful home textiles, table pieces and objects made with care in Pakistan.">
  <section class="aasra-hero" aria-labelledby="home-title">
    <div class="aasra-hero-media">
      <img src="/images/hero.webp" alt="A warm, lived-in home at the close of day" class="aasra-hero-image" width="2000" height="1125" fetchpriority="high" />
      <div class="aasra-hero-shade" aria-hidden="true"></div>
    </div>
    <div class="aasra-hero-copy">
      <p class="aasra-eyebrow">AASRA · Made for the everyday</p>
      <h1 id="home-title">A home, made<br /><em>more your own.</em></h1>
      <p class="aasra-hero-description">Considered pieces, natural materials and the small rituals that make a place feel like yours.</p>
      <div class="aasra-hero-actions">
        <a class="aasra-button aasra-button-light" href="/shop">Explore the collection <span aria-hidden="true">↗</span></a>
        <a class="aasra-quiet-link" href="/about">Meet AASRA</a>
      </div>
    </div>
    <div class="aasra-hero-foot"><span>Objects with a sense of place</span><span>Scroll to explore ↓</span></div>
  </section>

  <section class="aasra-intro reveal" aria-label="Our approach">
    <div class="container aasra-intro-grid">
      <p class="aasra-eyebrow">Our point of view</p>
      <p class="aasra-intro-statement">We believe the things we live with should feel <em>good to hold,</em> easy to use, and worth keeping.</p>
      <span class="aasra-intro-mark" aria-hidden="true">A.</span>
    </div>
    <div class="container aasra-values" data-stagger>
      <div class="aasra-value"><span>01</span><h2>Natural by nature</h2><p>Honest materials, chosen for the way they age and soften with time.</p></div>
      <div class="aasra-value"><span>02</span><h2>Made with care</h2><p>Thoughtful details and the human touch behind every piece.</p></div>
      <div class="aasra-value"><span>03</span><h2>Meant to be used</h2><p>Beautiful things belong in the rhythm of real, everyday life.</p></div>
    </div>
  </section>

  <section class="aasra-collections section" aria-labelledby="collections-title">
    <div class="container">
      <div class="aasra-section-heading reveal">
        <div><p class="aasra-eyebrow">Find your familiar</p><h2 id="collections-title">Made for the spaces<br /><em>in between.</em></h2></div>
        <a href="/shop" class="aasra-arrow-link">Browse everything <span aria-hidden="true">↗</span></a>
      </div>
      <div class="aasra-collection-grid" data-stagger>
        {collections.map((item, index) => (
          <a class:list={["aasra-collection-card", { "aasra-collection-card-offset": index === 1 || index === 3 }]} href={item.href}>
            <span class="aasra-collection-photo"><img src={item.image} alt={item.alt} loading="lazy" width="700" height="875" /><span class="aasra-collection-arrow" aria-hidden="true">↗</span></span>
            <span class="aasra-collection-meta"><span><strong>{item.title}</strong><small>{item.note}</small></span><span class="aasra-collection-index">0{index + 1}</span></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="aasra-featured section" aria-labelledby="featured-title">
    <div class="container">
      <div class="aasra-section-heading reveal">
        <div><p class="aasra-eyebrow">A few good things</p><h2 id="featured-title">The pieces we reach for.</h2><p class="aasra-section-intro">A considered edit of useful, tactile objects for slower mornings and longer evenings.</p></div>
        <a href="/new-arrivals" class="aasra-arrow-link">See what’s new <span aria-hidden="true">↗</span></a>
      </div>
      <div class="grid featured-grid aasra-product-grid" data-stagger>{featuredProducts.map((product) => <ProductCard product={product} />)}</div>
    </div>
  </section>

  <section class="aasra-maker section" aria-labelledby="maker-title">
    <div class="container aasra-maker-grid reveal">
      <div class="aasra-maker-image"><img src="/images/campaign/story-artisan.webp" alt="A maker's hands guiding cotton across a wooden loom" loading="lazy" width="1100" height="1250" /><span class="aasra-image-note">Hands, time, and a little patience.</span></div>
      <div class="aasra-maker-copy"><p class="aasra-eyebrow">Behind each detail</p><h2 id="maker-title">Made by people.<br /><em>Made to be lived with.</em></h2><p>Our collections begin with the makers, materials and traditions close to home. Each object carries the character of the hands that shaped it—never quite factory-perfect, always made with intention.</p><a href="/about" class="aasra-button">Our way of making <span aria-hidden="true">↗</span></a><div class="aasra-maker-caption"><span>01</span><span>Craft is not a finish. It is where we begin.</span></div></div>
    </div>
  </section>

  <section class="aasra-story-band" aria-label="AASRA at home">
    <img src="/images/campaign/banner-table.webp" alt="A table set with handmade ceramics and natural linen" loading="lazy" width="2000" height="900" />
    <div class="aasra-story-band-content reveal"><p class="aasra-eyebrow">Make room for together</p><h2>Good things happen<br /><em>around the table.</em></h2><a class="aasra-button aasra-button-light" href="/shop?category=tableware">Discover table pieces <span aria-hidden="true">↗</span></a></div>
  </section>

  <section class="aasra-journal section" aria-labelledby="journal-title">
    <div class="container">
      <div class="aasra-section-heading reveal"><div><p class="aasra-eyebrow">Notes from home</p><h2 id="journal-title">The AASRA journal.</h2></div><a href="/journal" class="aasra-arrow-link">Read all stories <span aria-hidden="true">↗</span></a></div>
      <div class="aasra-journal-grid" data-stagger>
        {journal.map((story, index) => <a class="aasra-journal-card" href={story.href}><span class="aasra-journal-image"><img src={story.image} alt={story.alt} loading="lazy" width="800" height="620" /></span><span class="aasra-eyebrow">{story.category} · 0{index + 1}</span><strong>{story.title}</strong><span class="aasra-journal-read">Read story <span aria-hidden="true">↗</span></span></a>)}
      </div>
    </div>
  </section>

  <section class="aasra-newsletter section" aria-labelledby="newsletter-title">
    <div class="container aasra-newsletter-inner reveal">
      <p class="aasra-eyebrow">A little note from us</p><h2 id="newsletter-title">Good things, occasionally.</h2><p>New work, stories from the makers, and thoughtful ideas for home. Only when there’s something worth sharing.</p>
      <form id="newsletter-form" class="aasra-newsletter-form">
        <label class="sr-only" for="newsletter-email">Your email address</label><input id="newsletter-email" type="email" name="email" placeholder="Your email address" required autocomplete="email" />
        <label class="aasra-newsletter-consent"><input type="checkbox" name="consent" required /> I agree to receive occasional AASRA updates.</label>
        <button type="submit" aria-label="Subscribe to the AASRA newsletter">Join the list <span aria-hidden="true">↗</span></button>
      </form>
      <p id="newsletter-msg" class="aasra-newsletter-message" aria-live="polite"></p>
    </div>
  </section>

  <script>
    // @ts-nocheck -- browser-only event handlers use DOM APIs guarded at runtime.
    document.getElementById('newsletter-form')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const form = e.target;
      const msg = document.getElementById('newsletter-msg');
      const btn = form.querySelector('button[type="submit"]');
      const email = form.elements.email.value;
      const consent = form.elements.consent.checked;
      try {
        btn.disabled = true;
        btn.innerHTML = 'Joining…';
        await window.__AASRA_CSRF?.ensure();
        const res = await fetch('/api/newsletter', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', ...(window.__AASRA_CSRF?.header() || {}) },
          body: JSON.stringify({ email, consent }),
        });
        const data = await res.json();
        if (data.ok) {
          msg.textContent = 'You’re on the list. Thank you.';
          msg.dataset.state = 'success';
          form.reset();
        } else {
          msg.textContent = data.error || 'Something went wrong. Please try again.';
          msg.dataset.state = 'error';
        }
      } catch {
        msg.textContent = 'Something went wrong. Please try again.';
        msg.dataset.state = 'error';
      } finally {
        btn.disabled = false;
        btn.innerHTML = 'Join the list <span aria-hidden="true">↗</span>';
      }
    });
  </script>
</Layout>
