---
import Layout from '../components/Layout.astro';
import ProductCard from '../components/ProductCard.astro';
import productsData from '../../data/products.json';
const featuredProducts = productsData.products.filter((product) => product.visible).slice(0, 4);

// Seasonal suggestion tiles — portrait imagery, serif titles (BC-style campaign row)
const seasonalTiles = [
  {
    label: 'Linen Curtains',
    href: '/shop?category=home-textiles',
    image: '/images/products/linen-curtain-ivory-1.webp',
  },
  {
    label: 'Dhurrie Rugs',
    href: '/shop?category=rugs',
    image: '/images/products/dhurrie-beige-1.webp',
  },
  {
    label: 'Artisan Tableware',
    href: '/shop?category=tableware',
    image: '/images/products/dinner-plate-1.webp',
  },
  {
    label: 'Teak Woodware',
    href: '/shop?category=woodware',
    image: '/images/products/teak-tray-1.webp',
  },
];
---

<Layout title="AASRA — considered essentials for the home" description="Considered home essentials, online in Pakistan. PKR. No Cash on Delivery.">
  <!-- 1. Campaign hero: full-bleed seasonal image, centered serif, two text links -->
  <section class="hero">
    <img src="/images/campaign/hero-winter.webp" alt="The winter edit" class="hero-image" loading="eager" width="2000" height="1125" fetchpriority="high" />
    <div class="hero-content">
      <div class="kicker">Holiday Season</div>
      <h1>The Winter Edit</h1>
      <p class="hero-sub">Warm linens, woven rugs, and candlelit tables — the season's considered gifts.</p>
      <div class="hero-links">
        <a href="/gifts">Gift Selection</a>
        <a href="/about">Discover the story</a>
      </div>
    </div>
  </section>

  <!-- 2. Seasonal suggestions: 4-up portrait tiles with serif titles -->
  <section class="section reveal">
    <div class="container">
      <div class="section-head reveal">
        <div class="kicker">Seasonal suggestions</div>
      </div>
      <div class="seasonal-grid" data-stagger>
        {seasonalTiles.map((tile) => (
          <a href={tile.href} class="seasonal-tile">
            <span class="tile-frame">
              <img src={tile.image} alt={tile.label} loading="lazy" width="600" height="750" />
            </span>
            <span class="seasonal-label">{tile.label}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Alternating category editorials: original AASRA photography and collection links -->
  <section class="section editorial-section">
    <div class="container">
      <article class="editorial-panel reveal">
        <a class="editorial-image" href="/shop?category=home-textiles"><img src="/images/campaign/gifts-home.webp" alt="Soft natural textures for the home" loading="lazy" width="900" height="1125" /></a>
        <div class="editorial-copy"><div class="kicker">The considered home</div><h2>Softness, woven into every day</h2><p>Natural fibres and gentle tones, made to become part of the way you live.</p><a class="text-link" href="/shop?category=home-textiles">Explore home textiles</a></div>
      </article>
      <article class="editorial-panel editorial-panel-reverse reveal">
        <a class="editorial-image" href="/shop?category=tableware"><img src="/images/campaign/gifts-table.webp" alt="A thoughtfully set table" loading="lazy" width="900" height="1125" /></a>
        <div class="editorial-copy"><div class="kicker">Gather around</div><h2>Objects for the shared table</h2><p>Hand-finished pieces for meals that stretch a little longer.</p><a class="text-link" href="/shop?category=tableware">Discover tableware</a></div>
      </article>
    </div>
  </section>

  <!-- Wide seasonal campaign -->
  <section class="section-tight reveal">
    <a href="/shop" class="wide-banner wide-banner-link campaign-band">
      <img src="/images/campaign/banner-table.webp" alt="The AASRA winter table campaign" loading="lazy" width="2000" height="900" />
      <div class="wide-content"><div class="kicker">AASRA, in season</div><h2>The Winter Edit</h2><p>Thoughtful things for a home in good company.</p><span class="hero-links"><span>Discover the collection</span></span></div>
    </a>
  </section>

  <!-- Featured products -->
  <section class="section reveal">
    <div class="container">
      <div class="section-head"><div class="kicker">A considered selection</div><h2>Featured pieces</h2><p class="section-sub">Objects chosen for their material, utility and enduring place in the home.</p></div>
      <div class="grid featured-grid" data-stagger>{featuredProducts.map((product) => <ProductCard product={product} />)}</div>
      <div class="editorial-cta"><a href="/shop" class="text-link">View all pieces</a></div>
    </div>
  </section>

  <!-- Craft and making -->
  <section class="section-tight craftsmanship-section reveal">
    <div class="container craftsmanship-panel">
      <img src="/images/campaign/story-artisan.webp" alt="An artisan handweaving a cotton dhurrie" loading="lazy" width="900" height="900" />
      <div><div class="kicker">Made with intention</div><h2>Good things take the time they deserve.</h2><p>We work with skilled makers and natural materials, celebrating the small variations that make each piece feel personal.</p><a class="text-link" href="/about">Our approach to craft</a></div>
    </div>
  </section>

  <!-- 7. Newsletter band -->
  <section class="section" style="border-top:1px solid var(--border); text-align:center;">
    <div class="container">
      <div class="kicker">Subscribe to our newsletter</div>
      <h2 style="margin-bottom:0.6rem;">News from the world of AASRA</h2>
      <p style="max-width:460px; margin:0 auto 1.75rem; color:var(--muted);">New collections, restocks, and seasonal edits. No spam.</p>
      <form id="newsletter-form" class="newsletter-form">
        <input type="email" name="email" placeholder="Your email address" required aria-label="Email address" />
        <label class="newsletter-consent"><input type="checkbox" name="consent" required /> I agree to receive occasional AASRA updates.</label>
        <button type="submit">Subscribe</button>
      </form>
      <p id="newsletter-msg" style="margin-top:0.75rem; font-size:0.8rem; color:var(--muted);"></p>
    </div>
  </section>

  <script>
    // @ts-nocheck -- browser-only event handlers use DOM APIs guarded at runtime.
    document.getElementById('newsletter-form')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const form = e.target;
      const msg = document.getElementById('newsletter-msg');
      const btn = form.querySelector('button[type="submit"]');
      const email = form.elements.email.value;
      const consent = form.elements.consent.checked;
      try {
        btn.disabled = true;
        btn.textContent = 'Subscribing...';
        await window.__AASRA_CSRF?.ensure();
        const res = await fetch('/api/newsletter', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', ...(window.__AASRA_CSRF?.header() || {}) },
          body: JSON.stringify({ email, consent }),
        });
        const data = await res.json();
        if (data.ok) {
          msg.textContent = 'Subscribed — thank you.';
          msg.style.color = '#1f5a1f';
          form.reset();
        } else {
          msg.textContent = data.error || 'Something went wrong.';
          msg.style.color = '#8a1f1f';
        }
      } catch (err) {
        msg.textContent = 'Something went wrong.';
        msg.style.color = '#8a1f1f';
      } finally {
        btn.disabled = false;
        btn.textContent = 'Subscribe';
      }
    });
  </script>
</Layout>
