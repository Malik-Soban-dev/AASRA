---
import Layout from '../components/Layout.astro';
---

<Layout title="Our Story — AASRA" description="AASRA — considered home essentials for Pakistan. Natural materials, honest construction, quiet prices.">
  <!-- Full-bleed editorial hero -->
  <section class="hero" style="height:min(62vh,560px); min-height:420px;">
    <img src="/images/campaign/story-artisan.webp" alt="Handweaving a cotton dhurrie" class="hero-image" loading="eager" width="2000" height="1125" fetchpriority="high" />
    <div class="hero-content">
      <div class="kicker">Our story</div>
      <h1>The house of AASRA</h1>
    </div>
  </section>

  <!-- Manifesto -->
  <section class="section reveal">
    <div class="container" style="max-width:720px; text-align:center;">
      <p class="section-sub" style="font-family:var(--serif); font-size:1.5rem; line-height:1.7; color:var(--text);">
        "We make few things, carefully, from materials that age well —
        and we sell them at honest prices, to homes that will actually use them."
      </p>
      <p style="margin-top:1.4rem; color:var(--muted);">AASRA means shelter, support, refuge. Every object we sell is made to serve that idea: quiet, useful, lasting.</p>
    </div>
  </section>

  <!-- Values: three columns -->
  <section class="section-tight reveal">
    <div class="container">
      <div class="values-grid" data-stagger>
        <div class="value-block">
          <div class="kicker">01</div>
          <h3>Natural materials</h3>
          <p>Pure linen, handwoven cotton, solid teak, glazed stoneware. No shortcuts, no blends that pretend. Materials chosen to soften and improve with years of use.</p>
        </div>
        <div class="value-block">
          <div class="kicker">02</div>
          <h3>Honest construction</h3>
          <p>Flat-weave rugs that take weeks on the loom. Curtain panels sewn with proper hems. Ceramics fired for daily use, not display. Construction you can inspect up close.</p>
        </div>
        <div class="value-block">
          <div class="kicker">03</div>
          <h3>Quiet prices</h3>
          <p>Luxury, without the markup theatre. Everything priced in PKR, and everything payable online in full.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Editorial split: the craft -->
  <section class="section-tight reveal">
    <div class="container">
      <div class="split-grid">
        <div>
          <img src="/images/campaign/story-artisan.webp" alt="Hands on the loom" loading="lazy" width="900" height="1125" style="width:100%; aspect-ratio:4/5; object-fit:cover; display:block;" />
        </div>
        <div style="display:flex; flex-direction:column; justify-content:center;">
          <div class="kicker">The craft</div>
          <h2 style="margin-bottom:1rem;">Woven, thrown, stitched by hand</h2>
          <p style="color:var(--muted); line-height:1.9;">
            Our dhurries are woven on wooden handlooms in Punjab, cotton thread by cotton thread.
            Our linen is cut and sewn in small runs — never mass stock. Our ceramics are thrown
            and glazed in studio batches, each plate slightly its own. What arrives at your door
            carries the marks of the hands that made it.
          </p>
          <div class="hero-links" style="justify-content:flex-start; margin-top:1.8rem;">
            <a href="/shop" style="color:var(--text); border-bottom-color:var(--text);">Shop the collection</a>
            <a href="/responsibility" style="color:var(--text); border-bottom-color:var(--text);">Our responsibility</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Service promise -->
  <section class="section-tight reveal">
    <div class="container" style="max-width:760px; text-align:center;">
      <div class="kicker">The promise</div>
      <h2 style="margin-bottom:1rem;">A house that answers</h2>
      <p style="color:var(--muted); line-height:1.9;">
        Real people, on Email and email, in your timezone. Help choosing sizes, gift
        wrapping in natural linen with a handwritten note, delivery across Pakistan, and
        returns honoured without argument. Explore our <a href="/services" style="text-decoration:underline; text-underline-offset:3px;">services</a>.
      </p>
    </div>
  </section>
</Layout>

<style>
  .values-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 2.5rem; text-align: center; }
  .value-block h3 { margin-bottom: 0.7rem; }
  .value-block p { color: var(--muted); font-size: 0.875rem; line-height: 1.8; }
  @media (max-width: 820px) { .values-grid { grid-template-columns: 1fr; } }
</style>
